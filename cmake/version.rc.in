// version.rc.in - PE version info resource template (configure_file -> version.rc)
// Single source of truth: include/colang/version.h (parsed in CMakeLists, @VAR@ substituted here).
// NOTE: kept ASCII-only, rc.exe codepage behavior varies by machine (same policy as build.bat).
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @COLANG_VER_MAJOR@,@COLANG_VER_MINOR@,@COLANG_VER_PATCH@,0
 PRODUCTVERSION @COLANG_VER_MAJOR@,@COLANG_VER_MINOR@,@COLANG_VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "colang compiler\0"
            VALUE "FileVersion", "@COLANG_VERSION_STRING@\0"
            VALUE "InternalName", "colang\0"
            VALUE "LegalCopyright", "Apache-2.0\0"
            VALUE "OriginalFilename", "colang.exe\0"
            VALUE "ProductName", "colang\0"
            VALUE "ProductVersion", "@COLANG_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
