// —— ws2_32 ioctlsocket 命令（值按 winsock2.h；u_long 为 32 位，按底层 unsigned int 书写；ADR-106 后 `.co` 内 long=8）——
public const unsigned int FIONBIO = 0x8004667e;
public const unsigned int FIONREAD = 0x4004667f;

// —— ws2_32 专用结构（仅本段函数使用；定义紧邻其使用者；x64 自然对齐，字段按底层类型书写）——
// WSADATA（winsock2.h，10.0.26100.0 实测 sizeof=408 align=8）、hostent（winsock2.h，sizeof=32）经 sizeof+offsetof 证伪后手写。
public struct WSADATA
{
	unsigned short wVersion;        // @0
	unsigned short wHighVersion;    // @2
	unsigned short iMaxSockets;     // @4
	unsigned short iMaxUdpDg;       // @6
	char *lpVendorInfo;             // @8
	char szDescription[257];        // @16  (WSADESCRIPTION_LEN+1)
	char szSystemStatus[130];       // @273 (WSASYS_STATUS_LEN+2→实全 130 字节；尾 pad 至 408)
};
// hostent（winsock2.h，x64 sizeof=32，无实际 union——h_addr 是宏 #define h_addr h_addr_list[0]）
public struct hostent
{
	char *h_name;            // @0
	char **h_aliases;        // @8
	short h_addrtype;        // @16
	short h_length;          // @18
	char **h_addr_list;      // @24
};
public struct in_addr
{
	unsigned int s_addr;   // sizeof 4（简化：真实为 union S_un{b/w/S_addr}，首址同宽同 4）
};
public struct sockaddr
{
	unsigned short sa_family;   // ADDRESS_FAMILY（u_short, 2）
	char sa_data[14];           // sizeof sockaddr = 16
};
public struct sockaddr_in
{
	unsigned short sin_family;   // ADDRESS_FAMILY（2）
	unsigned short sin_port;     // 网络字节序（2）
	struct in_addr sin_addr;     // 4
	char sin_zero[8];            // 填充至 16；sizeof sockaddr_in = 16
};

// addrinfo：getaddrinfo 的出入参与链表结构（对照 SDK ws2tcpip.h struct addrinfo；x64 sizeof=48）
public struct addrinfo
{
	int ai_flags;                 // 偏移 0
	int ai_family;                // 4
	int ai_socktype;              // 8
	int ai_protocol;              // 12
	unsigned int ai_addrlen;      // socklen_t，16（指针成员前补至 24）
	char *ai_canonname;           // 24（SDK 顺序 canonname 先于 addr）
	struct sockaddr *ai_addr;     // 32
	struct addrinfo *ai_next;     // 40；sizeof addrinfo = 48
};

// fd_set：select 的读/写/异常就绪集（对照 SDK winsock2.h；x64 SOCKET=unsigned long long=8；sizeof fd_set=520）
public struct fd_set
{
	unsigned int fd_count;             // 偏移 0（u_int）；SOCKET 成员对齐 8 → 补至 8
	unsigned long long fd_array[64];   // SOCKET[FD_SETSIZE]，偏移 8；64*8=512；sizeof fd_set = 520
};
// timeval：select 超时（对照 SDK winsock2.h struct timeval；SDK 的 long 于 Windows 宽 4，
//   但 `.co` 内 long=8（ADR-106），故必须按底层 int 书写；sizeof=8）
public struct timeval
{
	int tv_sec;    // 偏移 0（SDK long，Windows 宽 4——`.co` 内 long=8 故此处写 int）
	int tv_usec;   // 4；sizeof timeval = 8
};

// —— ws2_32：[[lib("ws2_32")]] BSD 套接字起步族（段内字母序，case-sensitive：大写 WSA* 先于小写函数；SOCKET 形参/返回按底层类型 unsigned long long；struct sockaddr* 形参按指针 * 贴名）——
