// 内存映射视图访问权限（MapViewOfFile 的 dwDesiredAccess）
public const int FILE_MAP_COPY = 0x0001;
public const int FILE_MAP_WRITE = 0x0002;
public const int FILE_MAP_READ = 0x0004;
public const int FILE_MAP_ALL_ACCESS = 0x000F001F;   // memoryapi.h:35 → winnt.h:14957 SECTION_ALL_ACCESS；原误为 0xF（只落了低 4 位）
// 命名管道模式（CreateNamedPipeW 的 dwOpenMode/dwPipeMode）
public const int PIPE_ACCESS_INBOUND = 0x00000001;
public const int PIPE_ACCESS_OUTBOUND = 0x00000002;
public const int PIPE_ACCESS_DUPLEX = 0x00000003;
