// —— crypt32 专用常量（CryptoAPI 字符串编解码标志；真值源 wincrypt.h L20922–20945，CRYPT_STRING_* 作 int）——
public const int CRYPT_STRING_BASE64 = 0x00000001;
public const int CRYPT_STRING_BINARY = 0x00000002;
public const int CRYPT_STRING_HEX = 0x00000004;
public const int CRYPT_STRING_HEXRAW = 0x0000000C;
public const int CRYPT_STRING_NOCRLF = 0x40000000;   // CRYPT_STRING_NOSPACE 已删：SDK 零定义，且 0x10000000 实为 CRYPT_STRING_HASHDATA

// —— crypt32：[[lib("crypt32")]] CryptoAPI 起步族（Base64/十六进制编解码，纯缓冲进出、本地可硬验证；BOOL 按 int、BYTE* 按 char*、DWORD 按 int）——
[[lib("crypt32")]] public int CryptBinaryToStringA(const char *pbBinary, int cbBinary, int dwFlags, char *pszString, int *pcchString);
[[lib("crypt32")]] public int CryptStringToBinaryA(const char *pszString, int cchString, int dwFlags, char *pbBinary, int *pcbBinary, int *pdwSkip, int *pdwFlags);

// —— 已知边界（消费方必读；均为 compiler 层而非声明层局限，本文件不尝试绕过）——
// ① 按值聚合体形参（struct/union by value）：【P352 已修复】此前 colang 曾把此类形参一律降为 `ptr`
//     （旧 IR 可证：`declare ptr @WindowFromPoint(ptr)`），而 winx64 ABI 要求 ≤ 8 字节聚合体整块进一个通用寄存器。
//     P352 后，Windows x64 目标下按值 struct/union 形参/返回均以 LLVM first-class 聚合类型参与签名，
//     交由 LLVM winx64 后端按 Microsoft x64 ABI 归类降法；外部 API（WindowFromPoint/SetFilePointerEx）传参/收返已正确。
//     非 win64（Linux/32 位）逐字维持旧降法，行为不变。本段仅作历史说明，新代码无需规避。
// ② 资源名宏 MAKEINTRESOURCE 未建模：本文件只存整型宏（IDC_*/IDI_*），调用处在形参为指针的位置显式强转，如
//     `LoadCursorW(nullptr, (const wchar_t *)IDC_ARROW)`；无宏帮助转换。
// ③ A/W 无宏分派：只按字面名入库（…A/…W），不存在不带后缀的 `MessageBox(...)`；UNICODE 宏体系不适用于本模块。
// ④ DLL 导出的数据符号（只有 `__imp_X`、无 thunk）未建模，故本文件不纳入任何全局数据变量（如 WLEDITGRID*、msvcrt 导出变量）。
