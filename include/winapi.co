public const int PAGE_EXECUTE_WRITECOPY = 0x80;
public const int PAGE_GUARD = 0x100;
public const int PAGE_NOCACHE = 0x200;
// 全局堆分配标志（GlobalAlloc 的 uFlags）
public const int GMEM_FIXED = 0x0000;
public const int GMEM_MOVEABLE = 0x0002;
public const int GMEM_NOCOMPACT = 0x0010;
public const int GMEM_ZEROINIT = 0x0040;
public const int GPTR = 0x0040;
public const int GHND = 0x0042;   // WinBase.h:637 (GMEM_MOVEABLE|GMEM_ZEROINIT)；原误为 0x0002（只取了 MOVEABLE 一半）
// Wait 返回值（WaitForSingleObject 的返回）
public const int WAIT_OBJECT_0 = 0;
public const int WAIT_ABANDONED = 0x80;
public const int WAIT_TIMEOUT = 0x102;
// 同步对象标准访问权限（事件/ Mutex / 信号灯 / 定时器 的 dwDesiredAccess）
public const unsigned int SYNCHRONIZE = 0x00100000;
public const int WAIT_FAILED = 0xFFFFFFFF;
// 工具帮助快照标志（CreateToolhelp32Snapshot 的 dwFlags）
public const int TH32CS_SNAPHEAPLIST = 0x00000001;
public const int TH32CS_SNAPPROCESS = 0x00000002;
public const int TH32CS_SNAPTHREAD = 0x00000004;
public const int TH32CS_SNAPMODULE = 0x00000008;
public const int TH32CS_SNAPMODULE32 = 0x00000010;
public const int TH32CS_SNAPALL = 0x0000000F;   // TlHelp32.h:58 (HEAPLIST|PROCESS|THREAD|MODULE)；原误为 0x11（误并 SNAPMODULE32、漏 THREAD）
// INVALID_SNAPSHOT_HANDLE 已删：SDK 全树零定义，失败哨兵真名是 INVALID_HANDLE_VALUE（本文件 L249）
// 进程访问权限（OpenProcess 的 dwDesiredAccess）
public const int PROCESS_QUERY_INFORMATION = 0x0400;
public const int PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
