[[lib("ws2_32")]] public int connect(unsigned long long s, const struct sockaddr *name, int namelen);
[[lib("ws2_32")]] public int gethostname(char *name, int namelen);
[[lib("ws2_32")]] public unsigned int htonl(unsigned int hostlong);
[[lib("ws2_32")]] public unsigned short htons(unsigned short hostshort);
[[lib("ws2_32")]] public unsigned int inet_addr(const char *cp);
[[lib("ws2_32")]] public int listen(unsigned long long s, int backlog);
[[lib("ws2_32")]] public unsigned int ntohl(unsigned int netlong);
[[lib("ws2_32")]] public unsigned short ntohs(unsigned short netshort);
[[lib("ws2_32")]] public int recv(unsigned long long s, char *buf, int len, int flags);
[[lib("ws2_32")]] public int send(unsigned long long s, const char *msg, int len, int flags);
[[lib("ws2_32")]] public int shutdown(unsigned long long s, int how);
[[lib("ws2_32")]] public unsigned long long socket(int af, int type, int protocol);

