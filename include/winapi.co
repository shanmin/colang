// winapi.co — Win32 API 的 Co 模块化封装（起步集 · 0.3.0 winapi.co 落地）
//
// 定位：以 `.co` 模块替代传统 `windows.h` 的「声明 + 库归属」层，供 `import` 按名取用。
//   本模块只给「无 body 外部原型」：`public` 让符号可被 import 方引用（colang 对无 body
//   原型不注入 DLL /EXPORT），`[[lib("X")]]` 声明外部实现来自哪个库（→ COFF .drectve
//   /DEFAULTLIB）。kernel32 系符号经 CRT 默认库直链、无需 [[lib]]。
//
// 覆盖范围（起步）：函数封装 + 少量 Win32 结构布局（public struct，供 import 方按系统 ABI 构造/传参）。
//   DLL 导出的数据符号（只有 __imp_X、无 thunk）与 per-symbol 精确绑定属未建模/后置项，
//   故此处不纳入任何全局数据变量。全量 API 覆盖长期走 win32metadata + windows-rs 式自动生成、非手写。
//
// W 系原型参数用 const wchar_t*，依赖「右值宽字符串字面量降 UTF-16」地基
//   （调用方以 L"…" 传参，据此报 wchar_t* 并落 UTF-16 码元）。
//
// 声明排版（详 PROJECT.md §三 第 9 条）：函数返回指针的 `*` 贴类型侧（`void* f(...)`），
//   参数/变量指针的 `*` 贴名字侧（`void *p`）。二者解析等价、纯可读性取向。
//
// 排列顺序：各库段内按函数名字母序（case-sensitive，A/W 变体自然相邻）；段序 kernel32→user32→gdi32。

// —— Win32 结构布局（public · x64/LLP64 自然对齐；按依赖序 POINT→RECT→MSG→PAINTSTRUCT→WNDCLASS→SYSTEMTIME→LARGE_INTEGER→SIZE→LOGPEN→WNDCLASSEX→WNDCLASSEXW→MINMAXINFO→MONITORINFO→OPENFILENAMEW→BROWSEINFOW→STARTUPINFOW→PROCESS_INFORMATION→SECURITY_ATTRIBUTES→OVERLAPPED→FILE_NOTIFY_INFORMATION→SCROLLINFO→TOOLINFOW→CRITICAL_SECTION→INITCOMMONCONTROLSEX→GUID→LUID→MEMORYSTATUSEX→DWM_BLURBEHIND→CHOOSECOLORW→FILETIME→WIN32_FIND_DATAW→NMHDR→NMCUSTOMDRAW→FLASHWINFO→TRACKMOUSEEVENT→CREATESTRUCTW→DRAWITEMSTRUCT→MEASUREITEMSTRUCT→NOTIFYICONDATAW）——
// LONG=long(4)·DWORD=unsigned long(4)·句柄/PTR=void*(8)·LPARAM=long long(8)。原型里句柄仍作 void*（不透明句柄、回调指针、多态输出缓冲、可选 SECURITY_ATTRIBUTES 按设计留 void*，非漏收紧）。已定义布局的 39 类型（38 struct：POINT/RECT/MSG/PAINTSTRUCT/WNDCLASS/SYSTEMTIME/SIZE/LOGPEN/WNDCLASSEX/WNDCLASSEXW/MINMAXINFO/MONITORINFO/OPENFILENAMEW/BROWSEINFOW/STARTUPINFOW/PROCESS_INFORMATION/SECURITY_ATTRIBUTES/OVERLAPPED/FILE_NOTIFY_INFORMATION/SCROLLINFO/TOOLINFOW/CRITICAL_SECTION/INITCOMMONCONTROLSEX/GUID/LUID/MEMORYSTATUSEX/DWM_BLURBEHIND/CHOOSECOLORW/FILETIME/WIN32_FIND_DATAW/NMHDR/NMCUSTOMDRAW/FLASHWINFO/TRACKMOUSEEVENT/CREATESTRUCTW/DRAWITEMSTRUCT/MEASUREITEMSTRUCT/NOTIFYICONDATAW + 1 union：LARGE_INTEGER）凡对应之新函数形参均用具体 struct*/union*（既有 RegCreateKeyExW 之可选 lpSecurityAttributes 依「不动既有原型」仍留 void*；注：MINMAXINFO 系 WM_GETMINMAXINFO 的 lParam 载荷、无函数原型引用）。仍留 void* 的结构类形参＝GetTextMetricsA/W 的 TEXTMETRIC*（字段多、手写布局易错且无运行期证伪、留待 win32metadata 自动生成）；其余尚无 public 布局的结构亦仍 void*。
public struct POINT
{
	long x;
	long y;
};
public struct RECT
{
	long left;
	long top;
	long right;
	long bottom;
};
public struct MSG
{
	void *hwnd;
	unsigned long message;
	void *wParam;
	long long lParam;
	unsigned long time;
	struct POINT pt;
};
public struct PAINTSTRUCT
{
	void *hdc;
	int fErase;
	struct RECT rcPaint;
	int fRestore;
	int fIncUpdate;
	unsigned char rgbReserved[32];
};
public struct WNDCLASS
{
	unsigned long style;
	long long (*lpfnWndProc)(void *, unsigned int, void *, long long);
	int cbClsExtra;
	int cbWndExtra;
	void *hInstance;
	void *hIcon;
	void *hCursor;
	void *hbrBackground;
	const char *lpszMenuName;
	const char *lpszClassName;
};
public struct SYSTEMTIME
{
	unsigned short wYear;
	unsigned short wMonth;
	unsigned short wDayOfWeek;
	unsigned short wDay;
	unsigned short wHour;
	unsigned short wMinute;
	unsigned short wSecond;
	unsigned short wMilliseconds;
};
public union LARGE_INTEGER
{
	struct { unsigned long LowPart; long HighPart; };
	long long QuadPart;
};
public struct SIZE
{
	long cx;
	long cy;
};
public struct LOGPEN
{
	struct POINT poPenLocation;
	int iPenWidth;
	unsigned long oPenColor;
};
// WNDCLASSEX 按 A 系建模（lpszMenuName/lpszClassName 取 const char*，与既存 WNDCLASS 同风格），配 RegisterClassExA 使用；cbSize 须由调用方填 sizeof。
public struct WNDCLASSEX
{
	unsigned long cbSize;
	unsigned long style;
	long long (*lpfnWndProc)(void *, unsigned int, void *, long long);
	int cbClsExtra;
	int cbWndExtra;
	void *hInstance;
	void *hIcon;
	void *hCursor;
	void *hbrBackground;
	const char *lpszMenuName;
	const char *lpszClassName;
	void *hIconSm;
};
// WNDCLASSEXW = WNDCLASSEX 的宽字符版（lpszMenuName/lpszClassName 取 const wchar_t*），配 RegisterClassExW 使用；布局与 SDK tagWNDCLASSEXW 逐字段一致（cbSize/style 为 UINT、lpfnWndProc 为 WNDPROC、余为句柄 void*）；cbSize 须由调用方填 sizeof。
public struct WNDCLASSEXW
{
	unsigned long cbSize;
	unsigned long style;
	long long (*lpfnWndProc)(void *, unsigned int, void *, long long);
	int cbClsExtra;
	int cbWndExtra;
	void *hInstance;
	void *hIcon;
	void *hCursor;
	void *hbrBackground;
	const wchar_t *lpszMenuName;
	const wchar_t *lpszClassName;
	void *hIconSm;
};
// MINMAXINFO：WM_GETMINMAXINFO 的 lParam 指向本结构（5 个 POINT）；布局对照 SDK tagMINMAXINFO。
public struct MINMAXINFO
{
	struct POINT ptReserved;
	struct POINT ptMaxSize;
	struct POINT ptMaxPosition;
	struct POINT ptMinTrackSize;
	struct POINT ptMaxTrackSize;
};
// MONITORINFO：GetMonitorInfoW 的第二参数（cbSize 需先填 sizeof）；布局对照 SDK tagMONITORINFO（DWORD cbSize / RECT rcMonitor / RECT rcWork / DWORD dwFlags）。
public struct MONITORINFO
{
	unsigned long cbSize;
	struct RECT rcMonitor;
	struct RECT rcWork;
	unsigned long dwFlags;
};
// OPENFILENAMEW：GetOpenFileNameW/GetSaveFileNameW 参数（commdlg.h tagOFNW）。cbSize/各 DWORD 作 unsigned long，句柄(hwndOwner/hInstance)/回调(lpfnHook)/保留(pvReserved) 作 void*，lCustData=LPARAM 作 long long，WORD 索引起止作 unsigned short；lpstrFile/lpstrCustomFilter/lpstrFileTitle 为调用方分配的 wchar_t 缓冲区，只读入参用 const wchar_t*。cbSize 须由调用方填 sizeof。对照 SDK 10.0.26100.0 逐字段核对。
public struct OPENFILENAMEW
{
	unsigned long lStructSize;
	void *hwndOwner;
	void *hInstance;
	const wchar_t *lpstrFilter;
	wchar_t *lpstrCustomFilter;
	unsigned long nMaxCustFilter;
	unsigned long nFilterIndex;
	wchar_t *lpstrFile;
	unsigned long nMaxFile;
	wchar_t *lpstrFileTitle;
	unsigned long nMaxFileTitle;
	const wchar_t *lpstrInitialDir;
	const wchar_t *lpstrTitle;
	unsigned long Flags;
	unsigned short nFileOffset;
	unsigned short nFileExtension;
	const wchar_t *lpstrDefExt;
	long long lCustData;
	void *lpfnHook;
	const wchar_t *lpTemplateName;
	void *pvReserved;
	unsigned long dwReserved;
	unsigned long FlagsEx;
};
// BROWSEINFOW：SHBrowseForFolderW 参数（shlobj.h _BROWSEINFOW）。hwndOwner/pidlRoot/lpfn(回调)/作 void*，pszDisplayName 为调用方缓冲区 wchar_t*，lpszTitle 只读 const wchar_t*，ulFlags=UINT 作 unsigned int，lParam=LPARAM 作 long long，iImage=int。对照 SDK 核对。
public struct BROWSEINFOW
{
	void *hwndOwner;
	void *pidlRoot;
	wchar_t *pszDisplayName;
	const wchar_t *lpszTitle;
	unsigned int ulFlags;
	void *lpfn;
	long long lParam;
	int iImage;
};

// STARTUPINFOW：CreateProcessW 启动信息（进程/管道重定向用）；对照 SDK x64 tagSTARTUPINFOW。lpReserved/lpDesktop/lpTitle 实为 LPWSTR、此处按只读 const wchar_t* 声明不影响布局；cb 须由调用方填 sizeof。
public struct STARTUPINFOW
{
	unsigned long cb;
	const wchar_t *lpReserved;
	const wchar_t *lpDesktop;
	const wchar_t *lpTitle;
	unsigned long dwX;
	unsigned long dwY;
	unsigned long dwXSize;
	unsigned long dwYSize;
	unsigned long dwXCountChars;
	unsigned long dwYCountChars;
	unsigned long dwFillAttribute;
	unsigned long dwFlags;
	unsigned short wShowWindow;
	unsigned short cbReserved2;
	unsigned char *lpReserved2;
	void *hStdInput;
	void *hStdOutput;
	void *hStdError;
};
// PROCESS_INFORMATION：CreateProcessW 输出进程/线程句柄与 id；对照 SDK。
public struct PROCESS_INFORMATION
{
	void *hProcess;
	void *hThread;
	unsigned long dwProcessId;
	unsigned long dwThreadId;
};
// SECURITY_ATTRIBUTES：句柄继承/安全描述符（CreateProcessW/CreateFileW/CreatePipe 用）；对照 SDK。
public struct SECURITY_ATTRIBUTES
{
	unsigned long nLength;
	void *lpSecurityDescriptor;
	int bInheritHandle;
};
// OVERLAPPED：异步 IO 状态块；SDK 的 union{Offset/OffsetHigh;Pointer} 摊成两 DWORD、x64 布局等价（32B）。
public struct OVERLAPPED
{
	unsigned long long Internal;
	unsigned long long InternalHigh;
	unsigned long Offset;
	unsigned long OffsetHigh;
	void *hEvent;
};
// FILE_NOTIFY_INFORMATION：ReadDirectoryChangesW 输出条目（柔性 FileName、宽字符）。
public struct FILE_NOTIFY_INFORMATION
{
	unsigned long NextEntryOffset;
	unsigned long Action;
	unsigned long FileNameLength;
	wchar_t FileName[1];
};
// SCROLLINFO：Get/SetScrollInfo 滚动条状态；对照 SDK tagSCROLLINFO。cbSize 须由调用方填 sizeof。
public struct SCROLLINFO
{
	unsigned int cbSize;
	unsigned int fMask;
	int nMin;
	int nMax;
	unsigned int nPage;
	int nPos;
	int nTrackPos;
};
// TOOLINFOW：SendMessage(TTM_ADDTOOLW) 的 tooltip 项（内嵌 struct RECT）；对照 SDK tagTOOLINFOW。cbSize 填 sizeof、uId=UINT_PTR。
public struct TOOLINFOW
{
	unsigned int cbSize;
	unsigned int uFlags;
	void *hwnd;
	unsigned long long uId;
	struct RECT rect;
	void *hinst;
	wchar_t *lpszText;
	long long lParam;
	void *lpReserved;
};
// CRITICAL_SECTION：即 RTL_CRITICAL_SECTION（Initialize/Enter/Leave/DeleteCriticalSection 用）；对照 SDK x64。
public struct CRITICAL_SECTION
{
	unsigned long long DebugInfo;
	long LockCount;
	long RecursionCount;
	void *OwningThread;
	void *LockSemaphore;
	unsigned long long SpinCount;
};
// INITCOMMONCONTROLSEX：InitCommonControlsEx 的初始化请求；对照 SDK。dwSize 填 sizeof。
public struct INITCOMMONCONTROLSEX
{
	unsigned long dwSize;
	unsigned long dwICC;
};
// GUID：COM/注册表通用唯一标识；对照 SDK guiddef.h（Data4 为 8 字节数组）。sysmon 早期以私有别名 GUIDX 兜底，现行改用真名 GUID。
public struct GUID
{
	unsigned long Data1;
	unsigned short Data2;
	unsigned short Data3;
	unsigned char Data4[8];
};
// LUID：本地唯一标识符（显卡适配器/访问令牌）；对照 SDK winnt.h。sysmon 早期以私有别名 LUIDX 兜底，现行改用真名 LUID。
public struct LUID
{
	unsigned long LowPart;
	long HighPart;
};
// MEMORYSTATUSEX：GlobalMemoryStatusEx 的内存状态载荷；对照 SDK sysinfoapi.h。dwLength 填 sizeof。
public struct MEMORYSTATUSEX
{
	unsigned long dwLength;
	unsigned long dwMemoryLoad;
	unsigned long long ullTotalPhys;
	unsigned long long ullAvailPhys;
	unsigned long long ullTotalPageFile;
	unsigned long long ullAvailPageFile;
	unsigned long long ullTotalVirtual;
	unsigned long long ullAvailVirtual;
	unsigned long long ullAvailExtendedVirtual;
};
// DWM_BLURBEHIND：DwmEnableBlurBehindWindow 的模糊描述；对照 SDK dwmapi.h。HRGN 句柄作 void*。
public struct DWM_BLURBEHIND
{
	unsigned long dwFlags;
	int fEnable;
	void *hRgnBlur;
	int fTransitionOnMaximized;
};
// CHOOSECOLORW：ChooseColorW 的颜色对话框参数；对照 SDK tagCHOOSECOLORW。COLORREF=unsigned long、LPARAM=long long、lpfnHook 函数指针作 void*。lStructSize 填 sizeof。
public struct CHOOSECOLORW
{
	unsigned long lStructSize;
	void *hwndOwner;
	void *hInstance;
	unsigned long rgbResult;
	unsigned long *lpCustColors;
	unsigned long Flags;
	long long lCustData;
	void *lpfnHook;
	const wchar_t *lpTemplateName;
};
// FILETIME：100ns 计数时间（文件时间/FindData 载荷）；对照 SDK minwinbase.h。两 DWORD 组合为 64 位。
public struct FILETIME
{
	unsigned long dwLowDateTime;
	unsigned long dwHighDateTime;
};
// WIN32_FIND_DATAW：FindFirstFileW/FindNextFileW 的文件项；对照 SDK minwinbase.h。MAX_PATH=260、cAlternateFileName 为 8.3 名(14)。
public struct WIN32_FIND_DATAW
{
	unsigned long dwFileAttributes;
	struct FILETIME ftCreationTime;
	struct FILETIME ftLastAccessTime;
	struct FILETIME ftLastWriteTime;
	unsigned long nFileSizeHigh;
	unsigned long nFileSizeLow;
	unsigned long dwReserved0;
	unsigned long dwReserved1;
	wchar_t cFileName[260];
	wchar_t cAlternateFileName[14];
};
// NMHDR：通用控件 WM_NOTIFY 通知头；对照 SDK commctrl.h。idFrom=UINT_PTR、hwndFrom=HWND。
public struct NMHDR
{
	void *hwndFrom;
	unsigned long long idFrom;
	unsigned int code;
};
// NMCUSTOMDRAW：CDDS_* 自绘通知载荷（内嵌 struct NMHDR/RECT）；对照 SDK commctrl.h。dwItemSpec=UINT_PTR、lItemlParam=LPARAM。
public struct NMCUSTOMDRAW
{
	struct NMHDR hdr;
	unsigned long dwDrawStage;
	void *hdc;
	struct RECT rc;
	unsigned long long dwItemSpec;
	unsigned int uItemState;
	long long lItemlParam;
};
// FLASHWINFO：FlashWindowEx 的任务栏/标题栏闪烁参数；对照 SDK WinUser.h。cbSize 填 sizeof、hwnd=HWND。
public struct FLASHWINFO
{
	unsigned long cbSize;
	void *hwnd;
	unsigned long dwFlags;
	unsigned int uCount;
	unsigned long dwTimeout;
};
// TRACKMOUSEEVENT：TrackMouseEvent 的光标离开/悬停追踪参数；对照 SDK WinUser.h。cbSize 填 sizeof、hwndTrack=HWND。
public struct TRACKMOUSEEVENT
{
	unsigned long cbSize;
	unsigned long dwFlags;
	void *hwndTrack;
	unsigned long dwHoverTime;
};
// CREATESTRUCTW：WM_CREATE 的 lParam 载荷；对照 SDK WinUser.h。句柄作 void*、lpszName/lpszClass 为 LPCWSTR。
public struct CREATESTRUCTW
{
	void *lpCreateParams;
	void *hInstance;
	void *hMenu;
	void *hwndParent;
	int cy;
	int cx;
	int y;
	int x;
	long style;
	const wchar_t *lpszName;
	const wchar_t *lpszClass;
	unsigned long dwExStyle;
};
// DRAWITEMSTRUCT：WM_DRAWITEM owner-draw 绘制参数（内嵌 struct RECT）；对照 SDK WinUser.h。CtlType/CtlID/itemID/itemAction/itemState 均 UINT、hwndItem=HWND、hDC=HDC、itemData=ULONG_PTR。
public struct DRAWITEMSTRUCT
{
	unsigned int CtlType;
	unsigned int CtlID;
	unsigned int itemID;
	unsigned int itemAction;
	unsigned int itemState;
	void *hwndItem;
	void *hDC;
	struct RECT rcItem;
	unsigned long long itemData;
};
// MEASUREITEMSTRUCT：WM_MEASUREITEM owner-draw 尺寸测量参数；对照 SDK WinUser.h。CtlType/CtlID/itemID/itemWidth/itemHeight 均 UINT、itemData=ULONG_PTR。
public struct MEASUREITEMSTRUCT
{
	unsigned int CtlType;
	unsigned int CtlID;
	unsigned int itemID;
	unsigned int itemWidth;
	unsigned int itemHeight;
	unsigned long long itemData;
};
// NOTIFYICONDATAW：Shell_NotifyIconW 的托盘图标项（Vista+ 布局，含 hBalloonIcon）；对照 SDK shellapi.h。cbSize 填 sizeof；超时/版本匿名 union 二字段同为 UINT、collapse 为 uVersion、4 字节 ABI 不变；guidItem 用已定义 struct GUID、HICON 作 void*。
public struct NOTIFYICONDATAW
{
	unsigned long cbSize;
	void *hWnd;
	unsigned int uID;
	unsigned int uFlags;
	unsigned int uCallbackMessage;
	void *hIcon;
	wchar_t szTip[128];
	unsigned long dwState;
	unsigned long dwStateMask;
	wchar_t szInfo[256];
	unsigned long uVersion;
	wchar_t szInfoTitle[64];
	unsigned long dwInfoFlags;
	struct GUID guidItem;
	void *hBalloonIcon;
};

// —— Win32 整型常量宏（P225/P226 · `public const int` 起步子集，供 import 按名取用、替代消费方十进制硬编码）——
//   仅覆盖整型常量宏；MAKEINTRESOURCE/字符串/指针型宏仍需别的机制或维持硬编码（长期交 win32metadata 自动生成）。
//   机制：被 import 的 const int 全局可作运行期读取/数组维度/switch case 标签（P256：parser eval_const_int 穿透 const 全局/局部 VarRef；常量种子经 loader const_seeds 前置入主源解析期）。
//   非负哨兵（如 INVALID_FILE_ATTRIBUTES=0xFFFFFFFF）按 `const unsigned long` 声明与消费方同型，免符号位转换。
//   注：const 限定当前不强制只读（本仓 sema 少诊断），按只读约定使用。
public const int COLOR_WINDOW = 5;
public const int CP_UTF8 = 65001;
public const int CS_HREDRAW = 2;
public const int CS_VREDRAW = 1;
public const int CW_USEDEFAULT = -2147483648;
public const int IDC_ARROW = 32512;
public const unsigned long INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF;
public const int LOGPIXELSX = 88;
public const int MAX_PATH = 260;
public const int PATCOPY = 0x00F00062;
public const int PM_NOREMOVE = 0;
public const int PM_REMOVE = 1;
public const int SM_CXSCREEN = 78;
public const int SRCCOPY = 0x00CC0020;
public const int SW_SHOW = 5;
public const int VK_SHIFT = 0x10;
public const int WHITE_BRUSH = 0;
public const int WM_DESTROY = 2;
public const int WM_PAINT = 15;
public const int WM_QUIT = 18;
public const int WS_OVERLAPPEDWINDOW = 0xCF0000;

// —— Win32 GUI 常量扩展（批次 VII · 范围 A 可发布子集；取值逐个对照 Windows SDK winuser.h / wingdi.h〔10.0.26100.0〕核对）——
// 窗口样式 WS_*（dwStyle 为 DWORD；仅 WS_POPUP 高位溢出 int，按 const unsigned long 声明，余皆落 int 正区间）
public const int WS_OVERLAPPED = 0x00000000;
public const unsigned long WS_POPUP = 0x80000000;
public const int WS_CHILD = 0x40000000;
public const int WS_VISIBLE = 0x10000000;
public const int WS_DISABLED = 0x08000000;
public const int WS_CAPTION = 0x00C00000;
public const int WS_BORDER = 0x00800000;
public const int WS_DLGFRAME = 0x00400000;
public const int WS_VSCROLL = 0x00200000;
public const int WS_HSCROLL = 0x00100000;
public const int WS_SYSMENU = 0x00080000;
public const int WS_THICKFRAME = 0x00040000;
public const int WS_MINIMIZEBOX = 0x00020000;
public const int WS_MAXIMIZEBOX = 0x00010000;
public const int WS_MINIMIZE = 0x20000000;
public const int WS_MAXIMIZE = 0x01000000;
public const int WS_CLIPSIBLINGS = 0x04000000;
public const int WS_CLIPCHILDREN = 0x02000000;
public const int WS_GROUP = 0x00020000;
public const int WS_TABSTOP = 0x00010000;
// 扩展窗口样式 WS_EX_*
public const int WS_EX_DLGMODALFRAME = 0x00000001;
public const int WS_EX_TOPMOST = 0x00000008;
public const int WS_EX_TRANSPARENT = 0x00000020;
public const int WS_EX_TOOLWINDOW = 0x00000080;
public const int WS_EX_WINDOWEDGE = 0x00000100;
public const int WS_EX_CLIENTEDGE = 0x00000200;
public const int WS_EX_STATICEDGE = 0x00020000;
// ShowWindow 命令 SW_*（SW_SHOW=5 已存于上方）
public const int SW_HIDE = 0;
public const int SW_SHOWNORMAL = 1;
public const int SW_SHOWMINIMIZED = 2;
public const int SW_SHOWMAXIMIZED = 3;
public const int SW_SHOWNOACTIVATE = 4;
public const int SW_SHOWMINNOACTIVE = 7;
public const int SW_SHOWNA = 8;
public const int SW_RESTORE = 9;
public const int SW_SHOWDEFAULT = 10;
// 窗口消息 WM_*（WM_DESTROY=2/WM_PAINT=15/WM_QUIT=18 已存于上方）
public const int WM_NULL = 0x0000;
public const int WM_CREATE = 0x0001;
public const int WM_MOVE = 0x0003;
public const int WM_SIZE = 0x0005;
public const int WM_ACTIVATE = 0x0006;
public const int WM_SETFOCUS = 0x0007;
public const int WM_KILLFOCUS = 0x0008;
public const int WM_ENABLE = 0x000A;
public const int WM_SETTEXT = 0x000C;
public const int WM_GETTEXT = 0x000D;
public const int WM_GETTEXTLENGTH = 0x000E;
