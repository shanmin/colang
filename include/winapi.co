// winapi.co — Win32 API 的 Co 模块化封装（起步集 · 0.3.0 winapi.co 落地）
//
// 定位：以 `.co` 模块替代传统 `windows.h` 的「声明 + 库归属」层，供 `import` 按名取用。
//   本模块只给「无 body 外部原型」：`public` 让符号可被 import 方引用（colang 对无 body
//   原型不注入 DLL /EXPORT），`[[lib("X")]]` 声明外部实现来自哪个库（→ COFF .drectve
//   /DEFAULTLIB）。kernel32 系符号经 CRT 默认库直链、无需 [[lib]]。
//
// 覆盖范围（起步）：函数封装 + 少量 Win32 结构布局（public struct，供 import 方按系统 ABI 构造/传参）。
//   DLL 导出的数据符号（只有 __imp_X、无 thunk）与 per-symbol 精确绑定属未建模/后置项，
//   故此处不纳入任何全局数据变量。全量 API 覆盖长期走 win32metadata + windows-rs 式自动生成、非手写。
//
// W 系原型参数用 const wchar_t*，依赖「右值宽字符串字面量降 UTF-16」地基
//   （调用方以 L"…" 传参，据此报 wchar_t* 并落 UTF-16 码元）。
//
// 声明排版（详 PROJECT.md §三 第 9 条）：函数返回指针的 `*` 贴类型侧（`void* f(...)`），
//   参数/变量指针的 `*` 贴名字侧（`void *p`）。二者解析等价、纯可读性取向。
//
// 排列顺序：各库段内按函数名字母序（case-sensitive，A/W 变体自然相邻）；段序 kernel32→user32→gdi32。

// —— Win32 结构布局（public · x64/LLP64 自然对齐；按依赖序 POINT→RECT→MSG→PAINTSTRUCT→WNDCLASS→SYSTEMTIME→LARGE_INTEGER→SIZE→LOGPEN→WNDCLASSEX）——
// LONG=long(4)·DWORD=unsigned long(4)·句柄/PTR=void*(8)·LPARAM=long long(8)。原型里句柄仍作 void*；已定义布局的 10 类型（9 struct：POINT/RECT/MSG/PAINTSTRUCT/WNDCLASS/SYSTEMTIME/SIZE/LOGPEN/WNDCLASSEX + 1 union：LARGE_INTEGER）指针用具体 struct*/union*（2026-10-23 收紧；2026-10-24 补 SYSTEMTIME 收紧 GetSystemTime/GetLocalTime、补 LARGE_INTEGER〔union+匿名 struct、colang 支持 union〕收紧 QueryPerformance*）。TEXTMETRIC 对应形参仍 void*（字段多、手写布局易错且无运行期校验、交 win32metadata 自动生成）；其余尚无布局的结构亦仍 void*。
public struct POINT
{
	long x;
	long y;
};
public struct RECT
{
	long left;
	long top;
	long right;
	long bottom;
};
public struct MSG
{
	void *hwnd;
	unsigned long message;
	void *wParam;
	long long lParam;
	unsigned long time;
	struct POINT pt;
};
public struct PAINTSTRUCT
{
	void *hdc;
	int fErase;
	struct RECT rcPaint;
	int fRestore;
	int fIncUpdate;
	unsigned char rgbReserved[32];
};
public struct WNDCLASS
{
	unsigned long style;
	long long (*lpfnWndProc)(void *, unsigned int, void *, long long);
	int cbClsExtra;
	int cbWndExtra;
	void *hInstance;
	void *hIcon;
	void *hCursor;
	void *hbrBackground;
	const char *lpszMenuName;
	const char *lpszClassName;
};
public struct SYSTEMTIME
{
	unsigned short wYear;
	unsigned short wMonth;
	unsigned short wDayOfWeek;
	unsigned short wDay;
	unsigned short wHour;
	unsigned short wMinute;
	unsigned short wSecond;
	unsigned short wMilliseconds;
};
public union LARGE_INTEGER
{
	struct { unsigned long LowPart; long HighPart; };
	long long QuadPart;
};
public struct SIZE
{
	long cx;
	long cy;
};
public struct LOGPEN
{
	struct POINT poPenLocation;
	int iPenWidth;
	unsigned long oPenColor;
};
// WNDCLASSEX 按 A 系建模（lpszMenuName/lpszClassName 取 const char*，与既存 WNDCLASS 同风格），配 RegisterClassExA 使用；cbSize 须由调用方填 sizeof。
public struct WNDCLASSEX
{
	unsigned long cbSize;
	unsigned long style;
	long long (*lpfnWndProc)(void *, unsigned int, void *, long long);
	int cbClsExtra;
	int cbWndExtra;
	void *hInstance;
	void *hIcon;
	void *hCursor;
	void *hbrBackground;
	const char *lpszMenuName;
	const char *lpszClassName;
	void *hIconSm;
};
// WNDCLASSEXW = WNDCLASSEX 的宽字符版（lpszMenuName/lpszClassName 取 const wchar_t*），配 RegisterClassExW 使用；布局与 SDK tagWNDCLASSEXW 逐字段一致（cbSize/style 为 UINT、lpfnWndProc 为 WNDPROC、余为句柄 void*）；cbSize 须由调用方填 sizeof。
public struct WNDCLASSEXW
{
	unsigned long cbSize;
	unsigned long style;
	long long (*lpfnWndProc)(void *, unsigned int, void *, long long);
	int cbClsExtra;
	int cbWndExtra;
	void *hInstance;
	void *hIcon;
	void *hCursor;
	void *hbrBackground;
	const wchar_t *lpszMenuName;
	const wchar_t *lpszClassName;
	void *hIconSm;
};
// MINMAXINFO：WM_GETMINMAXINFO 的 lParam 指向本结构（5 个 POINT）；布局对照 SDK tagMINMAXINFO。
public struct MINMAXINFO
{
	struct POINT ptReserved;
	struct POINT ptMaxSize;
	struct POINT ptMaxPosition;
	struct POINT ptMinTrackSize;
	struct POINT ptMaxTrackSize;
};
// MONITORINFO：GetMonitorInfoW 的第二参数（cbSize 需先填 sizeof）；布局对照 SDK tagMONITORINFO（DWORD cbSize / RECT rcMonitor / RECT rcWork / DWORD dwFlags）。
public struct MONITORINFO
{
	unsigned long cbSize;
	struct RECT rcMonitor;
	struct RECT rcWork;
	unsigned long dwFlags;
};

// —— Win32 整型常量宏（P225/P226 · `public const int` 起步子集，供 import 按名取用、替代消费方十进制硬编码）——
//   仅覆盖整型常量宏；MAKEINTRESOURCE/字符串/指针型宏仍需别的机制或维持硬编码（长期交 win32metadata 自动生成）。
//   机制：被 import 的 const int 全局可作运行期读取/数组维度/switch case 标签（P256：parser eval_const_int 穿透 const 全局/局部 VarRef；常量种子经 loader const_seeds 前置入主源解析期）。
//   非负哨兵（如 INVALID_FILE_ATTRIBUTES=0xFFFFFFFF）按 `const unsigned long` 声明与消费方同型，免符号位转换。
//   注：const 限定当前不强制只读（本仓 sema 少诊断），按只读约定使用。
public const int COLOR_WINDOW = 5;
public const int CP_UTF8 = 65001;
public const int CS_HREDRAW = 2;
public const int CS_VREDRAW = 1;
public const int CW_USEDEFAULT = -2147483648;
public const int IDC_ARROW = 32512;
public const unsigned long INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF;
public const int LOGPIXELSX = 88;
public const int PATCOPY = 0x00F00062;
public const int PM_NOREMOVE = 0;
public const int PM_REMOVE = 1;
public const int SM_CXSCREEN = 78;
public const int SRCCOPY = 0x00CC0020;
public const int SW_SHOW = 5;
public const int VK_SHIFT = 0x10;
public const int WHITE_BRUSH = 0;
public const int WM_DESTROY = 2;
public const int WM_PAINT = 15;
public const int WM_QUIT = 18;
public const int WS_OVERLAPPEDWINDOW = 0xCF0000;

