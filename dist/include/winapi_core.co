// —— user32 专用结构（仅本段函数使用；定义紧邻其使用者）——
public struct MSG
{
	HWND hwnd;
	UINT message;
	WPARAM wParam;
	LPARAM lParam;
	DWORD time;
	struct POINT pt;
};
public struct PAINTSTRUCT
{
	HDC hdc;
	BOOL fErase;
	struct RECT rcPaint;
	BOOL fRestore;
	BOOL fIncUpdate;
	BYTE rgbReserved[32];
};
public struct WNDCLASS
{
	UINT style;
	WNDPROC lpfnWndProc;
	int cbClsExtra;
	int cbWndExtra;
	HINSTANCE hInstance;
	HICON hIcon;
	HCURSOR hCursor;
	HBRUSH hbrBackground;
	LPCSTR lpszMenuName;
	LPCSTR lpszClassName;
};
// WNDCLASSW = WNDCLASS 的宽字符版（lpszMenuName/lpszClassName 取 const wchar_t*），配 RegisterClassW 使用；布局与 SDK tagWNDCLASSW 逐字段一致（style 为 UINT、lpfnWndProc 为 WNDPROC、余为句柄 void*）。
public struct WNDCLASSW
{
	UINT style;
	WNDPROC lpfnWndProc;
	int cbClsExtra;
	int cbWndExtra;
	HINSTANCE hInstance;
	HICON hIcon;
	HCURSOR hCursor;
	HBRUSH hbrBackground;
	LPCWSTR lpszMenuName;
	LPCWSTR lpszClassName;
};
// WNDCLASSEX 按 A 系建模（lpszMenuName/lpszClassName 取 const char*，与既存 WNDCLASS 同风格），配 RegisterClassExA 使用；cbSize 须由调用方填 sizeof。
public struct WNDCLASSEX
{
	UINT cbSize;
	UINT style;
	WNDPROC lpfnWndProc;
	int cbClsExtra;
	int cbWndExtra;
	HINSTANCE hInstance;
	HICON hIcon;
	HCURSOR hCursor;
	HBRUSH hbrBackground;
	LPCSTR lpszMenuName;
	LPCSTR lpszClassName;
	HICON hIconSm;
};
// WNDCLASSEXW = WNDCLASSEX 的宽字符版（lpszMenuName/lpszClassName 取 const wchar_t*），配 RegisterClassExW 使用；布局与 SDK tagWNDCLASSEXW 逐字段一致（cbSize/style 为 UINT、lpfnWndProc 为 WNDPROC、余为句柄 void*）；cbSize 须由调用方填 sizeof。
public struct WNDCLASSEXW
{
	UINT cbSize;
	UINT style;
	WNDPROC lpfnWndProc;
	int cbClsExtra;
	int cbWndExtra;
	HINSTANCE hInstance;
	HICON hIcon;
	HCURSOR hCursor;
	HBRUSH hbrBackground;
	LPCWSTR lpszMenuName;
	LPCWSTR lpszClassName;
	HICON hIconSm;
};
// MONITORINFO：GetMonitorInfoW 的第二参数（cbSize 需先填 sizeof）；布局对照 SDK tagMONITORINFO（DWORD cbSize / RECT rcMonitor / RECT rcWork / DWORD dwFlags）。
public struct MONITORINFO
{
	DWORD cbSize;
	struct RECT rcMonitor;
	struct RECT rcWork;
	DWORD dwFlags;
};
// SCROLLINFO：Get/SetScrollInfo 滚动条状态；对照 SDK tagSCROLLINFO。cbSize 须由调用方填 sizeof。
public struct SCROLLINFO
{
	UINT cbSize;
	UINT fMask;
	int nMin;
	int nMax;
	UINT nPage;
	int nPos;
	int nTrackPos;
};
// FLASHWINFO：FlashWindowEx 的任务栏/标题栏闪烁参数；对照 SDK WinUser.h。cbSize 填 sizeof、hwnd=HWND。
public struct FLASHWINFO
{
	UINT cbSize;
	HWND hwnd;
	DWORD dwFlags;
	UINT uCount;
	DWORD dwTimeout;
};
// TRACKMOUSEEVENT：TrackMouseEvent 的光标离开/悬停追踪参数；对照 SDK WinUser.h。cbSize 填 sizeof、hwndTrack=HWND。
public struct TRACKMOUSEEVENT
{
	DWORD cbSize;
	DWORD dwFlags;
	HWND hwndTrack;
	DWORD dwHoverTime;
};
// WINDOWPLACEMENT：Get/SetWindowPlacement 窗口位置状态；对照 SDK x64 tagWINDOWPLACEMENT。sizeof=44。length 须由调用方填 sizeof。
public struct WINDOWPLACEMENT
{
	DWORD length;
	DWORD flags;
	DWORD showCmd;
	struct POINT ptMinPosition;
	struct POINT ptMaxPosition;
	struct RECT rcNormalPosition;
};
// WINDOWINFO：GetWindowInfo 输出；对照 SDK x64 tagWINDOWINFO。sizeof=60。cbSize 须由调用方填 sizeof。
public struct WINDOWINFO
{
	DWORD cbSize;
	struct RECT rcWindow;
	struct RECT rcClient;
	DWORD dwStyle;
	DWORD dwExStyle;
	DWORD dwWindowStatus;
	UINT cxWindowBorders;
	UINT cyWindowBorders;
	WORD atomWindowType;
	WORD wCreatorVersion;
};
// MONITORINFOEXW：EnumDisplayMonitors/GetMonitorInfoW 的扩展变体（含设备名）；对照 SDK x64 tagMONITORINFOEXW。sizeof=104。cbSize 须填 sizeof。
public struct MONITORINFOEXW
{
	DWORD cbSize;
	struct RECT rcMonitor;
	struct RECT rcWork;
	DWORD dwFlags;
	WCHAR szDevice[32];
};
// KEYBDINPUT：SendInput 键盘输入子结构；对照 SDK x64 tagKEYBDINPUT。sizeof=24。
public struct KEYBDINPUT
{
	WORD wVk;
	WORD wScan;
	DWORD dwFlags;
	DWORD time;
	ULONG_PTR dwExtraInfo;
};
// MOUSEINPUT：SendInput 鼠标输入子结构；对照 SDK x64 tagMOUSEINPUT。sizeof=32。
public struct MOUSEINPUT
{
	LONG dx;
	LONG dy;
	DWORD mouseData;
	DWORD dwFlags;
	DWORD time;
	ULONG_PTR dwExtraInfo;
};
// HARDWAREINPUT：SendInput 硬件事件子结构；对照 SDK x64 tagHARDWAREINPUT。sizeof=8。
public struct HARDWAREINPUT
{
	DWORD uMsg;
	WORD wParamL;
	WORD wParamH;
};
// INPUTUNION：INPUT 内的匿名 union 命名版本（colang 无匿名 union，用命名 union 替代）。
public union INPUTUNION
{
	struct MOUSEINPUT mi;
	struct KEYBDINPUT ki;
	struct HARDWAREINPUT hi;
};
// INPUT：SendInput 输入事件结构体；对照 SDK x64 tagINPUT。sizeof=40。
public struct INPUT
{
	DWORD type;
	union INPUTUNION u;
};
// LASTINPUTINFO：GetLastInputInfo 闲置检测；对照 SDK x64 tagLASTINPUTINFO。sizeof=8。cbSize 须填 sizeof。
public struct LASTINPUTINFO
{
	UINT cbSize;
	DWORD dwTime;
};

