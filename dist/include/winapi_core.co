// winapi.co — Win32 API 的 Co 模块化封装（起步集 · 0.3.0 winapi.co 落地）
//
// 定位：以 `.co` 模块替代传统 `windows.h` 的「声明 + 库归属」层，供 `import` 按名取用。
//   本模块只给「无 body 外部原型」：`public` 让符号可被 import 方引用（colang 对无 body
//   原型不注入 DLL /EXPORT），`[[lib("X")]]` 声明外部实现来自哪个库（→ COFF .drectve
//   /DEFAULTLIB）。kernel32 系符号经 CRT 默认库直链、无需 [[lib]]。
//
// 覆盖范围（起步）：函数封装 + 少量 Win32 结构布局（public struct，供 import 方按系统 ABI 构造/传参）。
//   DLL 导出的数据符号（只有 __imp_X、无 thunk）与 per-symbol 精确绑定属未建模/后置项，
//   故此处不纳入任何全局数据变量。全量 API 覆盖长期靠自动生成、非手写。**校验链路已于 P376 改定**：
//   不再等 win32metadata，改由本机三件套直接对账——SDK 10.0.26100.0 头经 clang AST 出原型目录、
//   经 `-fdump-record-layouts` 出结构布局、System32 导出表出函数→库归属；入口 `_run_winapi_verify.ps1`，
//   产物 `_tmp\p376\diff_{prototype,struct,lib,const}.csv` 与 `verify_report.txt`。该回路只登记缺陷、
//   不改本文件；已登记者见 `HISTORY.md` P376 块。**（2026-11-06 甲+乙批已据此修复 18 项 DEFECT：14 原型＋1 常量＋3 结构，
//   详 PROJECT.md §九；余 DWM_BLURBEHIND／MEMORY_BASIC_INFORMATION 两项布局待核 clang 原文后再改。）**
//
// W 系原型参数用 const wchar_t*，依赖「右值宽字符串字面量降 UTF-16」地基
//   （调用方以 L"…" 传参，据此报 wchar_t* 并落 UTF-16 码元）。
//
// 声明排版（详项目内部设计文档的声明排版一节）：函数返回指针的 `*` 贴类型侧（`void* f(...)`），
//   参数/变量指针的 `*` 贴名字侧（`void *p`）。二者解析等价、纯可读性取向。
//
// 排列顺序：各库段内按函数名字母序（case-sensitive，A/W 变体自然相邻）；段序 kernel32→user32→gdi32。

// —— Win32 基础类型别名（public · 导出给 import 方）——
//   目的：让本文件内部声明与 SDK 头文件逐字同形（写 `DWORD cbSize;` 而非 `unsigned int cbSize;`），
//   并让消费方的 Win32 代码也能按同一套 SDK 拼写声明形参/局部量（不必一律退回 `unsigned int`）。
//   历史订正：0.3.0 落地时把本段判为「纯模块内别名」而刻意不加 `public`，依据是「colang 的 typedef
//   名不跨模块（实测显式 `import DWORD` 亦报未声明）」——该前提已被 ADR-115（0.4.1.40）推翻：
//   只有 `public typedef` 进导出面，裸 `typedef` 确实不跨，加了即可跨。故本段已全部补上 `public`
//   （外部报告 C-02 的落点；只改可见性标注，底层类型与宽度一字未动）。
//   副作用：这些名字现参与跨模块同名判定，消费方本地若另写同名 typedef/标签会与之相冲——
//   按「winapi 已收录的符号本模块不再手写」的既有纪律处理。
//   每个别名与其底层类型严格同一：结构体布局/ABI 与改前逐字节一致（改前/改后全 39 类型
//   sizeof 与关键字段偏移 A/B 比对必须全等）。
//   沿既有设计保留的例外：WPARAM 与句柄族作 void*；SDK 中为函数指针的回调成员（lpfnHook/lpfn）及不透明保留字段（pidlRoot/pvReserved/lpReserved）仍作 void*。
//   拼写取型：本文件不再出现 long/unsigned long——32 位一律写 int/unsigned int、64 位写 long long/unsigned long long。
//   ADR-106 已落地（0.5.0）：`.co` 内 long/unsigned long 恒 8 字节，故 SDK 里的 DWORD/LONG（各 4 字节）
//   必须写 int/unsigned int；沿用 long 会把字段撑到 8 字节、连带搞乱全部结构体布局。
public typedef unsigned int DWORD;               // DWORD = unsigned int (4)
public typedef unsigned int ULONG;               // ULONG = unsigned int (4)
public typedef unsigned int UINT;                // UINT  = unsigned int (4)
public typedef int LONG;                         // LONG  = int (4)
public typedef int INT;                          // INT   = int (4)
public typedef int BOOL;                         // BOOL  = int (4)
public typedef unsigned short WORD;              // WORD  = unsigned short (2)
public typedef unsigned char BYTE;               // BYTE  = unsigned char (1)
public typedef long long LONGLONG;               // LONGLONG = long long (8)
public typedef unsigned long long ULONGLONG;     // ULONGLONG = unsigned long long (8)
public typedef unsigned long long DWORDLONG;     // DWORDLONG = unsigned long long (8)
public typedef long long LONG_PTR;               // LONG_PTR = long long (8)
public typedef unsigned long long ULONG_PTR;     // ULONG_PTR = unsigned long long (8)
public typedef unsigned long long UINT_PTR;      // UINT_PTR = unsigned long long (8)
public typedef unsigned long long DWORD_PTR;     // DWORD_PTR = unsigned long long (8)
public typedef long long LPARAM;                 // LPARAM = long long (8)
public typedef long long LRESULT;                // LRESULT = long long (8)
public typedef unsigned int COLORREF;            // COLORREF = unsigned int (4)
public typedef wchar_t WCHAR;                    // WCHAR = wchar_t (2)
public typedef void *HANDLE;                     // 句柄族一律 void* (8)
public typedef void *HWND;
public typedef void *HDC;
public typedef void *HINSTANCE;
public typedef void *HMENU;
public typedef void *HICON;
public typedef void *HCURSOR;
public typedef void *HBRUSH;
public typedef void *HRGN;
public typedef void *LPVOID;
public typedef void *WPARAM;                     // 本文件既有映射：WPARAM 作 void*（SDK 为 UINT_PTR）
public typedef char *LPSTR;
public typedef const char *LPCSTR;
public typedef wchar_t *LPWSTR;
public typedef const wchar_t *LPCWSTR;
public typedef unsigned char *LPBYTE;
public typedef long long (*WNDPROC)(HWND, UINT, WPARAM, LPARAM);   // 即 LRESULT (CALLBACK*)(HWND,UINT,WPARAM,LPARAM)

// —— Win32 结构布局（public · x64/LLP64 自然对齐；此处只留跨段共用或无函数原型引用的通用结构，按依赖序 POINT→RECT→LARGE_INTEGER→MINMAXINFO→FILE_NOTIFY_INFORMATION→TOOLINFOW→GUID→LUID→NMHDR→NMCUSTOMDRAW→CREATESTRUCTW→DRAWITEMSTRUCT→MEASUREITEMSTRUCT）——
//   单库专用结构（仅被同一个库的函数引用）不留在本段，就近定义在对应库段的「<lib> 专用结构」小节、紧邻其使用者；判据＝原型区里该 struct 只出现在一个库段。
// 字段拼写＝SDK 别名（见上方别名段），底层宽度不变：DWORD/ULONG/COLORREF/UINT=unsigned int(4)·LONG/INT/BOOL=int(4)·WORD=unsigned short(2)·BYTE=unsigned char(1)·句柄/PTR/WPARAM=void*(8)·LPARAM/LRESULT/LONG_PTR=long long(8)·ULONGLONG/DWORDLONG/ULONG_PTR/UINT_PTR/DWORD_PTR=unsigned long long(8)；全文件不写 long/unsigned long（long 的定义将来会改，免连带漂移）。函数原型段仍按底层类型书写（本批只对齐结构体字段）；原型里句柄仍作 void*（不透明句柄、回调指针、多态输出缓冲、可选 SECURITY_ATTRIBUTES 按设计留 void*，非漏收紧）。已定义布局的 40 类型（39 struct + 1 union：LARGE_INTEGER；其中 13 个跨段共用或无原型引用者留在本段，27 个单库专用者下沉到各自库段——kernel32 9、user32 10、gdi32 2、comdlg32 2、shell32 2、comctl32 1、dwmapi 1）凡对应之新函数形参均用具体 struct*/union*（既有 RegCreateKeyExW 之可选 lpSecurityAttributes 依「不动既有原型」仍留 void*；注：MINMAXINFO 系 WM_GETMINMAXINFO 的 lParam 载荷、无函数原型引用）。仍留 void* 的结构类形参＝GetTextMetricsA/W 的 TEXTMETRIC*（字段多、手写布局易错且无运行期证伪、留待 win32metadata 自动生成）；其余尚无 public 布局的结构亦仍 void*。
public struct POINT
{
	LONG x;
	LONG y;
};
public struct RECT
{
	LONG left;
	LONG top;
	LONG right;
	LONG bottom;
};
public union LARGE_INTEGER
{
	struct { DWORD LowPart; LONG HighPart; };
	LONGLONG QuadPart;
};
// MINMAXINFO：WM_GETMINMAXINFO 的 lParam 指向本结构（5 个 POINT）；布局对照 SDK tagMINMAXINFO。
public struct MINMAXINFO
{
	struct POINT ptReserved;
	struct POINT ptMaxSize;
	struct POINT ptMaxPosition;
	struct POINT ptMinTrackSize;
	struct POINT ptMaxTrackSize;
};
// FILE_NOTIFY_INFORMATION：ReadDirectoryChangesW 输出条目（柔性 FileName、宽字符）。
public struct FILE_NOTIFY_INFORMATION
{
	DWORD NextEntryOffset;
	DWORD Action;
	DWORD FileNameLength;
	WCHAR FileName[1];
};
// TOOLINFOW：SendMessage(TTM_ADDTOOLW) 的 tooltip 项（内嵌 struct RECT）；对照 SDK tagTOOLINFOW。cbSize 填 sizeof、uId=UINT_PTR。
public struct TOOLINFOW
{
	UINT cbSize;
	UINT uFlags;
	HWND hwnd;
	UINT_PTR uId;
	struct RECT rect;
	HINSTANCE hinst;
	LPWSTR lpszText;
	LPARAM lParam;
	void *lpReserved;
};
// GUID：COM/注册表通用唯一标识；对照 SDK guiddef.h（Data4 为 8 字节数组）。sysmon 早期以私有别名 GUIDX 兜底，现行改用真名 GUID。
public struct GUID
{
	DWORD Data1;
	WORD Data2;
	WORD Data3;
	BYTE Data4[8];
};
// LUID：本地唯一标识符（显卡适配器/访问令牌）；对照 SDK winnt.h。sysmon 早期以私有别名 LUIDX 兜底，现行改用真名 LUID。
public struct LUID
{
	DWORD LowPart;
	LONG HighPart;
};
// NMHDR：通用控件 WM_NOTIFY 通知头；对照 SDK commctrl.h。idFrom=UINT_PTR、hwndFrom=HWND。
public struct NMHDR
{
	HWND hwndFrom;
	UINT_PTR idFrom;
	UINT code;
};
// NMCUSTOMDRAW：CDDS_* 自绘通知载荷（内嵌 struct NMHDR/RECT）；对照 SDK commctrl.h。dwItemSpec=DWORD_PTR、lItemlParam=LPARAM。
public struct NMCUSTOMDRAW
{
	struct NMHDR hdr;
	DWORD dwDrawStage;
	HDC hdc;
	struct RECT rc;
	DWORD_PTR dwItemSpec;
	UINT uItemState;
	LPARAM lItemlParam;
};
// CREATESTRUCTW：WM_CREATE 的 lParam 载荷；对照 SDK WinUser.h。句柄作 void*、lpszName/lpszClass 为 LPCWSTR。
public struct CREATESTRUCTW
{
	LPVOID lpCreateParams;
	HINSTANCE hInstance;
	HMENU hMenu;
	HWND hwndParent;
	int cy;
	int cx;
	int y;
	int x;
	LONG style;
	LPCWSTR lpszName;
	LPCWSTR lpszClass;
	DWORD dwExStyle;
};
// DRAWITEMSTRUCT：WM_DRAWITEM owner-draw 绘制参数（内嵌 struct RECT）；对照 SDK WinUser.h。CtlType/CtlID/itemID/itemAction/itemState 均 UINT、hwndItem=HWND、hDC=HDC、itemData=ULONG_PTR。
public struct DRAWITEMSTRUCT
{
	UINT CtlType;
	UINT CtlID;
	UINT itemID;
	UINT itemAction;
	UINT itemState;
	HWND hwndItem;
	HDC hDC;
	struct RECT rcItem;
	ULONG_PTR itemData;
};
// MEASUREITEMSTRUCT：WM_MEASUREITEM owner-draw 尺寸测量参数；对照 SDK WinUser.h。CtlType/CtlID/itemID/itemWidth/itemHeight 均 UINT、itemData=ULONG_PTR。
public struct MEASUREITEMSTRUCT
{
	UINT CtlType;
	UINT CtlID;
	UINT itemID;
	UINT itemWidth;
	UINT itemHeight;
	ULONG_PTR itemData;
};

// —— Win32 整型常量 · 跨库共用（P225/P226 起步；单库专用常量已下沉到各库段的「专用常量」小节）——
//   判据同结构体：常量只服务单一库（其取值只作为该库函数/结构的参数）→ 就近定义在该库段函数之前的「<lib> 专用常量」小节；被多个库共用的留本段。
//   机制：被 import 的 const int 全局可作运行期读取/数组维度/switch case 标签（P256：parser eval_const_int 穿透 const 全局/局部 VarRef；常量种子经 loader const_seeds 前置入主源解析期）。
//   非负哨兵（如 INVALID_FILE_ATTRIBUTES=0xFFFFFFFF）按 `const unsigned int` 声明与消费方同型，免符号位转换；const 限定当前不强制只读（本仓 sema 少诊断），按只读约定使用。
//   仅覆盖整型常量宏；MAKEINTRESOURCE/字符串/指针型宏仍需别的机制或维持硬编码（长期交 win32metadata 自动生成）。
//   来源与核对：P225/P226 起步子集 + 批次 VII–XII 扩展，取值逐个对照 Windows SDK〔10.0.26100.0〕winuser.h / wingdi.h / winbase.h / commctrl.h / commdlg.h / shlwapi.h / winnt.h / pdh.h / dwmapi.h。
public const int MAX_PATH = 260;

// —— kernel32 专用常量（仅本段函数使用；定义紧邻其使用者）——
// 基础码值（代码页标识 / 文件属性哨兵 / 成功码）
public const int CP_UTF8 = 65001;
public const unsigned int INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF;
// 代码页 / 字符转换
public const unsigned int CP_ACP = 0;
public const unsigned int MB_ERR_INVALID_CHARS = 0x00000008;
// 进程创建 / 优先级 / 等待
public const unsigned int CREATE_NO_WINDOW = 0x08000000;
public const unsigned int STARTF_USESHOWWINDOW = 0x00000001;
public const unsigned int STARTF_USESTDHANDLES = 0x00000100;
public const unsigned int HANDLE_FLAG_INHERIT = 0x00000001;
public const unsigned int IDLE_PRIORITY_CLASS = 0x00000040;
public const int THREAD_PRIORITY_IDLE = -15;
public const unsigned int INFINITE = 0xFFFFFFFF;
// 目录 / 文件监视（CreateFileW / ReadDirectoryChangesW）
public const unsigned int FILE_LIST_DIRECTORY = 0x00000001;
public const unsigned int FILE_SHARE_READ = 0x00000001;
public const unsigned int FILE_SHARE_WRITE = 0x00000002;
public const unsigned int FILE_SHARE_DELETE = 0x00000004;
public const unsigned int OPEN_EXISTING = 3;
public const unsigned int FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
public const unsigned int FILE_FLAG_OVERLAPPED = 0x40000000;
public const unsigned int FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
public const unsigned int FILE_NOTIFY_CHANGE_FILE_NAME = 0x00000001;
public const unsigned int FILE_NOTIFY_CHANGE_DIR_NAME = 0x00000002;
public const unsigned int FILE_NOTIFY_CHANGE_SIZE = 0x00000008;      // winnt.h:15336
public const unsigned int FILE_NOTIFY_CHANGE_LAST_WRITE = 0x00000010;   // winnt.h:15337（原误为 0x8，与 SIZE 撞值）
public const unsigned int FILE_ACTION_ADDED = 0x00000001;
public const unsigned int FILE_ACTION_REMOVED = 0x00000002;
public const unsigned int FILE_ACTION_MODIFIED = 0x00000003;
public const unsigned int FILE_ACTION_RENAMED_OLD_NAME = 0x00000004;
public const unsigned int FILE_ACTION_RENAMED_NEW_NAME = 0x00000005;
// 驱动器类型（GetDriveTypeW 返回值）
public const int DRIVE_FIXED = 3;
// 文件访问权限 / 创建Disposition / 定位基准（CreateFileW 的 dwDesiredAccess/dwCreationDisposition、SetFilePointer/Ex 的 dwMoveMethod）
//   GENERIC_READ 高位置位，按 const unsigned int 声明与消费方同型（同既有 WS_POPUP/TME_CANCEL 惯例）
public const unsigned int GENERIC_READ = 0x80000000;
public const unsigned int GENERIC_WRITE = 0x40000000;
public const unsigned int CREATE_ALWAYS = 2;
public const unsigned int OPEN_ALWAYS = 4;
public const unsigned int TRUNCATE_EXISTING = 5;
public const unsigned int FILE_BEGIN = 0;
public const unsigned int FILE_CURRENT = 1;
public const unsigned int FILE_END = 2;
// 伪句柄哨兵：真身 ((HANDLE)(LONG_PTR)-1)（handleapi.h），按整型宏存 -1，调用处与 (void *)INVALID_HANDLE_VALUE 比对（同既有 DPI_AWARENESS_CONTEXT_* / IDC_* 惯例）
public const int INVALID_HANDLE_VALUE = -1;
// 本地堆分配标志（LocalAlloc 的 uFlags；minwinbase.h:LPTR = LMEM_FIXED|LMEM_ZEROINIT 别名已摊平）
public const int LMEM_FIXED = 0x0000;
public const int LMEM_ZEROINIT = 0x0040;
public const int LPTR = 0x0040;
// 错误文本格式化标志（FormatMessageW 的 dwFlags）
public const int FORMAT_MESSAGE_ALLOCATE_BUFFER = 0x00000100;
public const int FORMAT_MESSAGE_IGNORE_INSERTS = 0x00000200;
public const int FORMAT_MESSAGE_FROM_STRING = 0x00000400;
public const int FORMAT_MESSAGE_FROM_HMODULE = 0x00000800;
public const int FORMAT_MESSAGE_FROM_SYSTEM = 0x00001000;
public const int FORMAT_MESSAGE_ARGUMENT_ARRAY = 0x00002000;
public const int FORMAT_MESSAGE_MAX_WIDTH_MASK = 0x000000FF;
// 系统错误码（GetLastError 返回值；供 CreateFileW/RemoveDirectoryW/RegisterHotKey 失败分支比对）
// 内存分配标志（VirtualAlloc 的 flAllocType）
public const int MEM_COMMIT = 0x1000;
public const int MEM_RESERVE = 0x2000;
public const int MEM_DECOMMIT = 0x4000;
public const int MEM_RELEASE = 0x8000;
public const int MEM_FREE = 0x10000;
public const int MEM_PRIVATE = 0x20000;
public const int MEM_MAPPED = 0x40000;
public const int MEM_IMAGE = 0x1000000;
public const int MEM_RESET = 0x80000;
// 内存保护属性（VirtualAlloc/VirtualProtect 的 flProtect）
public const int PAGE_NOACCESS = 0x01;
public const int PAGE_READONLY = 0x02;
public const int PAGE_READWRITE = 0x04;
public const int PAGE_WRITECOPY = 0x08;
public const int PAGE_EXECUTE = 0x10;
public const int PAGE_EXECUTE_READ = 0x20;
public const int PAGE_EXECUTE_READWRITE = 0x40;
public const int PAGE_EXECUTE_WRITECOPY = 0x80;
public const int PAGE_GUARD = 0x100;
public const int PAGE_NOCACHE = 0x200;
// 全局堆分配标志（GlobalAlloc 的 uFlags）
public const int GMEM_FIXED = 0x0000;
public const int GMEM_MOVEABLE = 0x0002;
public const int GMEM_NOCOMPACT = 0x0010;
public const int GMEM_ZEROINIT = 0x0040;
public const int GPTR = 0x0040;
public const int GHND = 0x0042;   // WinBase.h:637 (GMEM_MOVEABLE|GMEM_ZEROINIT)；原误为 0x0002（只取了 MOVEABLE 一半）
// Wait 返回值（WaitForSingleObject 的返回）
public const int WAIT_OBJECT_0 = 0;
public const int WAIT_ABANDONED = 0x80;
// 同步对象标准访问权限（事件/ Mutex / 信号灯 / 定时器 的 dwDesiredAccess）
public const unsigned int SYNCHRONIZE = 0x00100000;
public const int WAIT_FAILED = 0xFFFFFFFF;
// 工具帮助快照标志（CreateToolhelp32Snapshot 的 dwFlags）
public const int TH32CS_SNAPHEAPLIST = 0x00000001;
public const int TH32CS_SNAPPROCESS = 0x00000002;
public const int TH32CS_SNAPTHREAD = 0x00000004;
public const int TH32CS_SNAPMODULE = 0x00000008;
public const int TH32CS_SNAPMODULE32 = 0x00000010;
public const int TH32CS_SNAPALL = 0x0000000F;   // TlHelp32.h:58 (HEAPLIST|PROCESS|THREAD|MODULE)；原误为 0x11（误并 SNAPMODULE32、漏 THREAD）
// INVALID_SNAPSHOT_HANDLE 已删：SDK 全树零定义，失败哨兵真名是 INVALID_HANDLE_VALUE（本文件 L249）
// 进程访问权限（OpenProcess 的 dwDesiredAccess）
public const int PROCESS_QUERY_INFORMATION = 0x0400;
public const int PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
public const int PROCESS_VM_READ = 0x0010;
public const int PROCESS_VM_WRITE = 0x0020;
public const int PROCESS_VM_OPERATION = 0x0008;
public const int PROCESS_TERMINATE = 0x0001;
public const int PROCESS_ALL_ACCESS = 0x1FFFFF;
// 内存映射视图访问权限（MapViewOfFile 的 dwDesiredAccess）
public const int FILE_MAP_COPY = 0x0001;
public const int FILE_MAP_WRITE = 0x0002;
public const int FILE_MAP_READ = 0x0004;
public const int FILE_MAP_ALL_ACCESS = 0x000F001F;   // memoryapi.h:35 → winnt.h:14957 SECTION_ALL_ACCESS；原误为 0xF（只落了低 4 位）
// 命名管道模式（CreateNamedPipeW 的 dwOpenMode/dwPipeMode）
public const int PIPE_ACCESS_INBOUND = 0x00000001;
public const int PIPE_ACCESS_OUTBOUND = 0x00000002;
public const int PIPE_ACCESS_DUPLEX = 0x00000003;
public const int PIPE_TYPE_BYTE = 0x00000000;
public const int PIPE_TYPE_MESSAGE = 0x00000004;
public const int PIPE_WAIT = 0x00000000;
public const int NMPWAIT_WAIT_FOREVER = -1;
// 管道读模式（SetNamedPipeHandleState 的 dwReadMode）
// NPIPE_SERVER_TO_CLIENT / PNP_TERMINATE 已删：SDK 全树零定义的凭空名
public const int PIPE_READMODE_BYTE = 0;
public const int PIPE_REJECT_REMOTE_CLIENTS = 8;
public const int PIPE_ACCEPT_REMOTE_CLIENTS = 0;

// —— kernel32 专用结构（仅本段函数使用；定义紧邻其使用者）——
public struct SYSTEMTIME
{
	WORD wYear;
	WORD wMonth;
	WORD wDayOfWeek;
	WORD wDay;
	WORD wHour;
	WORD wMinute;
	WORD wSecond;
	WORD wMilliseconds;
};
// FILETIME：100ns 计数时间（文件时间/FindData 载荷）；对照 SDK minwinbase.h。两 DWORD 组合为 64 位。
public struct FILETIME
{
	DWORD dwLowDateTime;
	DWORD dwHighDateTime;
};
// WIN32_FIND_DATAW：FindFirstFileW/FindNextFileW 的文件项；对照 SDK minwinbase.h。MAX_PATH=260、cAlternateFileName 为 8.3 名(14)。
public struct WIN32_FIND_DATAW
{
	DWORD dwFileAttributes;
	struct FILETIME ftCreationTime;
	struct FILETIME ftLastAccessTime;
	struct FILETIME ftLastWriteTime;
	DWORD nFileSizeHigh;
	DWORD nFileSizeLow;
	DWORD dwReserved0;
	DWORD dwReserved1;
	WCHAR cFileName[260];
	WCHAR cAlternateFileName[14];
};
// BY_HANDLE_FILE_INFORMATION：GetFileInformationByHandle 的输出载荷；对照 SDK winbase.h x64。sizeof=52。
public struct BY_HANDLE_FILE_INFORMATION
{
	DWORD dwFileAttributes;                   // 偏移 0
	struct FILETIME ftCreationTime;           // 4
	struct FILETIME ftLastAccessTime;         // 12
	struct FILETIME ftLastWriteTime;          // 20
	DWORD dwVolumeSerialNumber;              // 28
	DWORD nFileSizeHigh;                     // 32
	DWORD nFileSizeLow;                      // 36
	DWORD nNumberOfLinks;                    // 40
	DWORD nFileIndexHigh;                    // 44
	DWORD nFileIndexLow;                     // 48
};
// WIN32_FILE_ATTRIBUTE_DATA：GetFileAttributesExW 的输出载荷；对照 SDK winbase.h x64。sizeof=36。
public struct WIN32_FILE_ATTRIBUTE_DATA
{
	DWORD dwFileAttributes;                  // 0
	struct FILETIME ftCreationTime;          // 4
	struct FILETIME ftLastAccessTime;        // 12
	struct FILETIME ftLastWriteTime;         // 20
	DWORD nFileSizeHigh;                    // 28
	DWORD nFileSizeLow;                     // 32
};
// MEMORY_BASIC_INFORMATION：VirtualQuery 的输出载荷；对照 SDK winnt.h x64。sizeof=48。
public struct MEMORY_BASIC_INFORMATION
{
	void *BaseAddress;                      // 0
	void *AllocationBase;                   // 8
	DWORD AllocationProtect;                // 16
	WORD PartitionId;                       // 20 (SDK winnt.h: PartitionId)
	unsigned long long RegionSize;          // 24
	DWORD State;                            // 32
	DWORD Protect;                          // 36
	DWORD Type;                             // 40 (4B tail pad for 8-byte alignment)
};
// OVERLAPPED：异步 IO 状态块；SDK 的 union{Offset/OffsetHigh;Pointer} 摊成两 DWORD、x64 布局等价（32B）。
public struct OVERLAPPED
{
	ULONG_PTR Internal;
	ULONG_PTR InternalHigh;
	DWORD Offset;
	DWORD OffsetHigh;
	HANDLE hEvent;
};
// CRITICAL_SECTION：即 RTL_CRITICAL_SECTION（Initialize/Enter/Leave/DeleteCriticalSection 用）；对照 SDK x64。
public struct CRITICAL_SECTION
{
	ULONG_PTR DebugInfo;
	LONG LockCount;
	LONG RecursionCount;
	HANDLE OwningThread;
	HANDLE LockSemaphore;
	ULONG_PTR SpinCount;
};
// MEMORYSTATUSEX：GlobalMemoryStatusEx 的内存状态载荷；对照 SDK sysinfoapi.h。dwLength 填 sizeof。
public struct MEMORYSTATUSEX
{
	DWORD dwLength;
	DWORD dwMemoryLoad;
	DWORDLONG ullTotalPhys;
	DWORDLONG ullAvailPhys;
	DWORDLONG ullTotalPageFile;
	DWORDLONG ullAvailPageFile;
	DWORDLONG ullTotalVirtual;
	DWORDLONG ullAvailVirtual;
	DWORDLONG ullAvailExtendedVirtual;
};
// SECURITY_ATTRIBUTES：句柄继承/安全描述符（CreateProcessW/CreateFileW/CreatePipe 用）；对照 SDK。
public struct SECURITY_ATTRIBUTES
{
	DWORD nLength;
	LPVOID lpSecurityDescriptor;
	BOOL bInheritHandle;
};
// LUID： locally unique identifier（NT 安全权限/登录会话）；对照 SDK winnt.h。sizeof=8。
public struct LUID
{
	DWORD LowPart;
	LONG HighPart;
};
// LUID_AND_ATTRIBUTES： LUID + 属性标志；sizeof=12。
public struct LUID_AND_ATTRIBUTES
{
	struct LUID Luid;
	DWORD Attributes;
};
// TOKEN_PRIVILEGES： AdjustTokenPrivileges 的权限集；SDK 声明为 1 个元素的数组，sizeof=16。
public struct TOKEN_PRIVILEGES
{
	DWORD PrivilegeCount;
	struct LUID_AND_ATTRIBUTES Privileges;
};
// STARTUPINFOW：CreateProcessW 启动信息（进程/管道重定向用）；对照 SDK x64 tagSTARTUPINFOW。lpReserved/lpDesktop/lpTitle 实为 LPWSTR、此处按只读 const wchar_t* 声明不影响布局；cb 须由调用方填 sizeof。
public struct STARTUPINFOW
{
	DWORD cb;
	LPCWSTR lpReserved;
	LPCWSTR lpDesktop;
	LPCWSTR lpTitle;
	DWORD dwX;
	DWORD dwY;
	DWORD dwXSize;
	DWORD dwYSize;
	DWORD dwXCountChars;
	DWORD dwYCountChars;
	DWORD dwFillAttribute;
	DWORD dwFlags;
	WORD wShowWindow;
	WORD cbReserved2;
	LPBYTE lpReserved2;
	HANDLE hStdInput;
	HANDLE hStdOutput;
	HANDLE hStdError;
};
// PROCESS_INFORMATION：CreateProcessW 输出进程/线程句柄与 id；对照 SDK。
public struct PROCESS_INFORMATION
{
	HANDLE hProcess;
	HANDLE hThread;
	DWORD dwProcessId;
	DWORD dwThreadId;
};
// SYSTEM_INFO：GetSystemInfo/GetNativeSystemInfo 输出；对照 SDK x64 _SYSTEM_INFO。dwOemId 与 wProcessorArchitecture+wReserved 构成 union，此处摊成两 WORD（偏移等价）。sizeof=48。
public struct SYSTEM_INFO
{
	WORD wProcessorArchitecture;
	WORD wReserved;
	DWORD dwPageSize;
	LPVOID lpMinimumApplicationAddress;
	LPVOID lpMaximumApplicationAddress;
	DWORD_PTR dwActiveProcessorMask;
	DWORD dwNumberOfProcessors;
	DWORD dwProcessorType;
	DWORD dwAllocationGranularity;
	WORD wProcessorLevel;
	WORD wProcessorRevision;
};
// PROCESSENTRY32W：CreateToolhelp32Snapshot/Process32FirstW/NextW 输出；对照 SDK x64 tagPROCESSENTRY32W。sizeof=568。dwSize 须填 sizeof。
public struct PROCESSENTRY32W
{
	DWORD dwSize;
	DWORD cntUsage;
	DWORD th32ProcessID;
	ULONG_PTR th32DefaultHeapID;
	DWORD th32ModuleID;
	DWORD cntThreads;
	DWORD th32ParentProcessID;
	LONG pcPriClassBase;
	DWORD dwFlags;
	WCHAR szExeFile[260];
};
// MODULEENTRY32W：Module32FirstW/NextW 输出；对照 SDK x64 tagMODULEENTRY32W。sizeof=1080。dwSize 须填 sizeof。
public struct MODULEENTRY32W
{
	DWORD dwSize;
	DWORD th32ModuleID;
	DWORD th32ProcessID;
	DWORD GlblcntUsage;
	DWORD ProccntUsage;
	unsigned char *modBaseAddr;
	DWORD modBaseSize;
	HINSTANCE hModule;
	WCHAR szModule[256];
	WCHAR szExePath[260];
};
// THREADENTRY32W：CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD)/Thread32FirstW/NextW 输出；对照 SDK x64 tagTHREADENTRY32。sizeof=28。dwSize 须填 sizeof。
public struct THREADENTRY32W
{
	DWORD dwSize;
	DWORD cntUsage;
	DWORD th32ThreadID;
	DWORD th32OwnerProcessID;
	LONG tpBasePri;
	LONG tpDeltaPri;
	DWORD dwFlags;
};
// SYSTEM_POWER_STATUS：GetSystemPowerStatus 输出；对照 SDK x64 _SYSTEM_POWER_STATUS。sizeof=12。
public struct SYSTEM_POWER_STATUS
{
	unsigned char ACLineStatus;
	unsigned char BatteryFlag;
	unsigned char BatteryLifePercent;
	unsigned char SystemStatusFlag;
	DWORD BatteryLifeTime;
	DWORD BatteryFullLifeTime;
};

