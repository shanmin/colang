public const int DEVICE_DEFAULT_FONT = 14;
public const int DEFAULT_PALETTE = 15;
public const int DEFAULT_GUI_FONT = 17;
// 光栅操作 ROP2（dwRop 为 DWORD，按 const unsigned int；SRCCOPY/PATCOPY 已存于上方）
public const unsigned int BLACKNESS = 0x00000042;
public const unsigned int NOTSRCCOPY = 0x00330008;
public const unsigned int SRCERASE = 0x00440328;
public const unsigned int DSTINVERT = 0x00550009;
public const unsigned int MERGECOPY = 0x00C000CA;
public const unsigned int MERGEPAINT = 0x00BB0226;
public const unsigned int SRCINVERT = 0x00660046;
public const unsigned int SRCAND = 0x008800C6;
public const unsigned int SRCPAINT = 0x00EE0086;
// 文本对齐 TA_*（SetTextAlign）与背景模式 BkMode
public const int TA_LEFT = 0;
public const int TA_TOP = 0;
public const int TA_RIGHT = 2;
public const int TA_CENTER = 6;
public const int TA_BOTTOM = 8;
public const int TA_BASELINE = 24;
public const int TRANSPARENT = 1;
public const int OPAQUE = 2;
// SetStretchBltMode 模式
public const int BLACKONWHITE = 1;
public const int WHITEONBLACK = 2;
// 字体创建参数（wingdi.h）：OUT_TT_PRECIS 真值 = 4（非 10，10 为 OUT_PS_ONLY_PRECIS）；FF_MODERN = 0x30
public const int FW_NORMAL = 400;
public const int DEFAULT_CHARSET = 1;
public const int OUT_DEFAULT_PRECIS = 0;
public const int OUT_TT_PRECIS = 4;
public const int CLIP_DEFAULT_PRECIS = 0;
