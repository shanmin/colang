// —— comdlg32 专用常量（仅本段函数使用；定义紧邻其使用者）——
// 文件对话框标志 OFN_*（OPENFILENAMEW.Flags）
public const int OFN_HIDEREADONLY = 0x00000004;
public const int OFN_PATHMUSTEXIST = 0x00000800;
public const int OFN_FILEMUSTEXIST = 0x00001000;
// 颜色对话框 ChooseColorW 的 Flags
public const int CC_RGBINIT = 0x00000001;
public const int CC_FULLOPEN = 0x00000002;

// —— comdlg32 专用结构（仅本段函数使用；定义紧邻其使用者）——
// OPENFILENAMEW：GetOpenFileNameW/GetSaveFileNameW 参数（commdlg.h tagOFNW）。cbSize/各 DWORD 作 unsigned int，句柄(hwndOwner/hInstance)/回调(lpfnHook)/保留(pvReserved) 作 void*，lCustData=LPARAM 作 long long，WORD 索引起止作 unsigned short；lpstrFile/lpstrCustomFilter/lpstrFileTitle 为调用方分配的 wchar_t 缓冲区，只读入参用 const wchar_t*。cbSize 须由调用方填 sizeof。对照 SDK 10.0.26100.0 逐字段核对。
public struct OPENFILENAMEW
{
	DWORD lStructSize;
	HWND hwndOwner;
	HINSTANCE hInstance;
	LPCWSTR lpstrFilter;
	LPWSTR lpstrCustomFilter;
	DWORD nMaxCustFilter;
	DWORD nFilterIndex;
	LPWSTR lpstrFile;
	DWORD nMaxFile;
	LPWSTR lpstrFileTitle;
	DWORD nMaxFileTitle;
	LPCWSTR lpstrInitialDir;
	LPCWSTR lpstrTitle;
	DWORD Flags;
	WORD nFileOffset;
	WORD nFileExtension;
	LPCWSTR lpstrDefExt;
	LPARAM lCustData;
	void *lpfnHook;
	LPCWSTR lpTemplateName;
	void *pvReserved;
	DWORD dwReserved;
	DWORD FlagsEx;
};
// CHOOSECOLORW：ChooseColorW 的颜色对话框参数；对照 SDK tagCHOOSECOLORW。lpCustColors 为调用方 COLORREF 数组、lpfnHook 函数指针按既有设计作 void*。lStructSize 填 sizeof。
public struct CHOOSECOLORW
{
	DWORD lStructSize;
	HWND hwndOwner;
	HWND hInstance;
	COLORREF rgbResult;
	COLORREF *lpCustColors;
	DWORD Flags;
	LPARAM lCustData;
	void *lpfnHook;
	LPCWSTR lpTemplateName;
};

// —— comdlg32：[[lib("comdlg32")]] 通用对话框（段内字母序）——
[[lib("comdlg32")]] public int ChooseColorW(struct CHOOSECOLORW *lpcc);
[[lib("comdlg32")]] public int GetOpenFileNameW(struct OPENFILENAMEW *lpofn);
[[lib("comdlg32")]] public int GetSaveFileNameW(struct OPENFILENAMEW *lpofn);

