// —— shell32 专用结构（仅本段函数使用；定义紧邻其使用者）——
// BROWSEINFOW：SHBrowseForFolderW 参数（shlobj.h _BROWSEINFOW）。hwndOwner/pidlRoot/lpfn(回调)/作 void*，pszDisplayName 为调用方缓冲区 wchar_t*，lpszTitle 只读 const wchar_t*，ulFlags=UINT 作 unsigned int，lParam=LPARAM 作 long long，iImage=int。对照 SDK 核对。
public struct BROWSEINFOW
{
	HWND hwndOwner;
	void *pidlRoot;
	LPWSTR pszDisplayName;
	LPCWSTR lpszTitle;
	UINT ulFlags;
	void *lpfn;
	LPARAM lParam;
	int iImage;
};
// NOTIFYICONDATAW：Shell_NotifyIconW 的托盘图标项（Vista+ 布局，含 hBalloonIcon）；对照 SDK shellapi.h。cbSize 填 sizeof；超时/版本匿名 union 二字段同为 UINT、collapse 为 uVersion、4 字节 ABI 不变；guidItem 用已定义 struct GUID，hIcon/hBalloonIcon=HICON（句柄族 void*）。
public struct NOTIFYICONDATAW
{
	DWORD cbSize;
	HWND hWnd;
	UINT uID;
	UINT uFlags;
	UINT uCallbackMessage;
	HICON hIcon;
	WCHAR szTip[128];
	DWORD dwState;
	DWORD dwStateMask;
	WCHAR szInfo[256];
	UINT uVersion;
	WCHAR szInfoTitle[64];
	DWORD dwInfoFlags;
	struct GUID guidItem;
	HICON hBalloonIcon;
};

