// —— kernel32 批次 X 补充（追加于段末、块内字母序；进程创建/管道/线程/临界区/目录监视）——
public int CancelIoEx(void *hFile, struct OVERLAPPED *lpOverlapped);
public void* CreateEventW(struct SECURITY_ATTRIBUTES *lpEventAttributes, int bManualReset, int bInitialState, const wchar_t *lpName);
public void* CreateFileW(const wchar_t *lpFileName, unsigned int dwDesiredAccess, unsigned int dwShareMode, struct SECURITY_ATTRIBUTES *lpSecurityAttributes, unsigned int dwCreationDisposition, unsigned int dwFlagsAndAttributes, void *hTemplateFile);
public int CreatePipe(void **hReadPipe, void **hWritePipe, struct SECURITY_ATTRIBUTES *lpPipeAttributes, unsigned int nSize);
public int CreateProcessW(const wchar_t *lpApplicationName, wchar_t *lpCommandLine, struct SECURITY_ATTRIBUTES *lpProcessAttributes, struct SECURITY_ATTRIBUTES *lpThreadAttributes, int bInheritHandles, unsigned int dwCreationFlags, void *lpEnvironment, const wchar_t *lpCurrentDirectory, struct STARTUPINFOW *lpStartupInfo, struct PROCESS_INFORMATION *lpProcessInformation);
public void* CreateThread(struct SECURITY_ATTRIBUTES *lpThreadAttributes, unsigned long long dwStackSize, unsigned int (*lpStartAddress)(void *), void *lpParameter, unsigned int dwCreationFlags, unsigned int *lpThreadId);
public void DeleteCriticalSection(struct CRITICAL_SECTION *lpCriticalSection);
public void EnterCriticalSection(struct CRITICAL_SECTION *lpCriticalSection);
public void* GetCurrentThread(void);
public int GetExitCodeProcess(void *hProcess, unsigned int *lpExitCode);
public int GetOverlappedResultEx(void *hFile, struct OVERLAPPED *lpOverlapped, unsigned int *lpNumberOfBytesTransferred, unsigned int dwMilliseconds, int bAlertable);
public void InitializeCriticalSection(struct CRITICAL_SECTION *lpCriticalSection);
public void LeaveCriticalSection(struct CRITICAL_SECTION *lpCriticalSection);
public int ReadDirectoryChangesW(void *hDirectory, void *lpBuffer, unsigned int nBufferLength, int bWatchSubtree, unsigned int dwNotifyFilter, unsigned int *lpBytesReturned, struct OVERLAPPED *lpOverlapped, void *lpCompletionRoutine);
public int ReadFile(void *hFile, void *lpBuffer, unsigned int nNumberOfBytesToRead, unsigned int *lpNumberOfBytesRead, struct OVERLAPPED *lpOverlapped);
public int ResetEvent(void *hEvent);
public int SetEvent(void *hEvent);
public int SetHandleInformation(void *hObject, unsigned int dwMask, unsigned int dwFlags);
public int SetPriorityClass(void *hProcess, unsigned int dwPriorityClass);
public int SetThreadPriority(void *hThread, int nPriority);
public unsigned int WaitForSingleObject(void *hHandle, unsigned int dwMilliseconds);
public unsigned int WaitForSingleObjectEx(void *hHandle, unsigned int dwMilliseconds, int bAlertable);

// —— kernel32 批次 XI 补充（追加于段末、块内字母序；互斥体/内存状态/语言 ID/逻辑驱动器）——
public void* CreateMutexW(struct SECURITY_ATTRIBUTES *lpMutexAttributes, int bInitialOwner, const wchar_t *lpName);
public unsigned int GetDriveTypeW(const wchar_t *lpRootPathName);
public unsigned int GetLogicalDriveStringsW(unsigned int nBufferLength, wchar_t *lpBuffer);
public unsigned short GetSystemDefaultLangID(void);
public int GlobalMemoryStatusEx(struct MEMORYSTATUSEX *lpBuffer);

// —— kernel32 批次 XII 补充（追加于段末、块内字母序；目录/文件枚举/文件读写定位/时间转换/进程终止）——
public int CreateDirectoryW(const wchar_t *lpPathName, struct SECURITY_ATTRIBUTES *lpSecurityAttributes);
public int DeleteFileW(const wchar_t *lpFileName);
public int FindClose(void *hFindFile);
public void* FindFirstFileW(const wchar_t *lpFileName, struct WIN32_FIND_DATAW *lpFindFileData);
public int FindNextFileW(void *hFindFile, struct WIN32_FIND_DATAW *lpFindFileData);
public int FlushFileBuffers(void *hFile);
public void GetSystemTimeAsFileTime(struct FILETIME *lpSystemTimeAsFileTime);
public int LocalFileTimeToFileTime(const struct FILETIME *lpLocalFileTime, struct FILETIME *lpFileTime);
public int MoveFileExW(const wchar_t *lpExistingFileName, const wchar_t *lpNewFileName, unsigned int dwFlags);
public int SetEndOfFile(void *hFile);
public unsigned int SetFilePointer(void *hFile, int lDistanceToMove, int *lpDistanceToMoveHigh, unsigned int dwMoveMethod);
public int SystemTimeToFileTime(const struct SYSTEMTIME *lpSystemTime, struct FILETIME *lpFileTime);
public int TerminateProcess(void *hProcess, unsigned int uExitCode);
public int WriteFile(void *hFile, const void *lpBuffer, unsigned int nNumberOfBytesToWrite, unsigned int *lpNumberOfBytesWritten, struct OVERLAPPED *lpOverlapped);

