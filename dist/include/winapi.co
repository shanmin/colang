// —— gdi32 专用结构（仅本段函数使用；定义紧邻其使用者）——
public struct SIZE
{
	LONG cx;
	LONG cy;
};
// 【待核·布局】SDK tagLOGPEN = { UINT lopnStyle; POINT lopnWidth; COLORREF lopnColor; }（x64 24 字节），
//   本结构现为 POINT+int+COLORREF（16 字节）且字段名不同——疑为布局缺陷（CreatePenIndirect 按 SDK 读字段会错位）。
//   本批只对齐类型拼写，不改布局/字段名（p215 依赖 poPenLocation/iPenWidth），问题另行定向。
public struct LOGPEN
{
	struct POINT poPenLocation;
	int iPenWidth;
	COLORREF oPenColor;
};

