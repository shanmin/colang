public const int DEFAULT_PALETTE = 15;
public const int DEFAULT_GUI_FONT = 17;
// 光栅操作 ROP2（dwRop 为 DWORD，按 const unsigned int；SRCCOPY/PATCOPY 已存于上方）
public const unsigned int BLACKNESS = 0x00000042;
public const unsigned int NOTSRCCOPY = 0x00330008;
public const unsigned int SRCERASE = 0x00440328;
public const unsigned int DSTINVERT = 0x00550009;
public const unsigned int MERGECOPY = 0x00C000CA;
public const unsigned int MERGEPAINT = 0x00BB0226;
public const unsigned int SRCINVERT = 0x00660046;
public const unsigned int SRCAND = 0x008800C6;
public const unsigned int SRCPAINT = 0x00EE0086;
// 文本对齐 TA_*（SetTextAlign）与背景模式 BkMode
