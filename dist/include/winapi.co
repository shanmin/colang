// winapi.co — Win32 API 的 Co 模块化封装（起步集 · 0.3.0 winapi.co 落地）
//
// 定位：以 `.co` 模块替代传统 `windows.h` 的「声明 + 库归属」层，供 `import` 按名取用。
//   本模块只给「无 body 外部原型」：`public` 让符号可被 import 方引用（colang 对无 body
//   原型不注入 DLL /EXPORT），`[[lib("X")]]` 声明外部实现来自哪个库（→ COFF .drectve
//   /DEFAULTLIB）。kernel32 系符号经 CRT 默认库直链、无需 [[lib]]。
//
// 覆盖范围（起步）：函数封装 + 少量 Win32 结构布局（public struct，供 import 方按系统 ABI 构造/传参）。
//   DLL 导出的数据符号（只有 __imp_X、无 thunk）与 per-symbol 精确绑定属未建模/后置项，
//   故此处不纳入任何全局数据变量。全量 API 覆盖长期走 win32metadata + windows-rs 式自动生成、非手写。
//
// W 系原型参数用 const wchar_t*，依赖「右值宽字符串字面量降 UTF-16」地基
//   （调用方以 L"…" 传参，据此报 wchar_t* 并落 UTF-16 码元）。
//
// 声明排版（详 PROJECT.md §三 第 9 条）：函数返回指针的 `*` 贴类型侧（`void* f(...)`），
//   参数/变量指针的 `*` 贴名字侧（`void *p`）。二者解析等价、纯可读性取向。
//
// 排列顺序：各库段内按函数名字母序（case-sensitive，A/W 变体自然相邻）；段序 kernel32→user32→gdi32。

// —— Win32 基础类型别名（模块内，不导出）——
//   目的：让本文件内部声明与 SDK 头文件逐字同形（写 `DWORD cbSize;` 而非 `unsigned int cbSize;`）。
//   性质：colang 的 typedef 名不跨模块（导入方看不到，实测显式 `import DWORD` 亦报未声明），
//   故这是纯模块内别名——消费方仍按 struct 名用成员，对外契约零变化。
//   每个别名与其底层类型严格同一：结构体布局/ABI 与改前逐字节一致（改前/改后全 39 类型
//   sizeof 与关键字段偏移 A/B 比对必须全等）。
//   沿既有设计保留的例外：WPARAM 与句柄族作 void*；SDK 中为函数指针的回调成员（lpfnHook/lpfn）及不透明保留字段（pidlRoot/pvReserved/lpReserved）仍作 void*。
//   拼写取型：本文件不再出现 long/unsigned long——32 位一律写 int/unsigned int（long 的定义后续会改，避开连带漂移）、64 位写 long long/unsigned long long。
typedef unsigned int DWORD;               // DWORD = unsigned int (4)
typedef unsigned int ULONG;               // ULONG = unsigned int (4)
typedef unsigned int UINT;                // UINT  = unsigned int (4)
typedef int LONG;                         // LONG  = int (4)
typedef int INT;                          // INT   = int (4)
typedef int BOOL;                         // BOOL  = int (4)
typedef unsigned short WORD;              // WORD  = unsigned short (2)
typedef unsigned char BYTE;               // BYTE  = unsigned char (1)
typedef long long LONGLONG;               // LONGLONG = long long (8)
typedef unsigned long long ULONGLONG;     // ULONGLONG = unsigned long long (8)
typedef unsigned long long DWORDLONG;     // DWORDLONG = unsigned long long (8)
typedef long long LONG_PTR;               // LONG_PTR = long long (8)
typedef unsigned long long ULONG_PTR;     // ULONG_PTR = unsigned long long (8)
typedef unsigned long long UINT_PTR;      // UINT_PTR = unsigned long long (8)
typedef unsigned long long DWORD_PTR;     // DWORD_PTR = unsigned long long (8)
typedef long long LPARAM;                 // LPARAM = long long (8)
typedef long long LRESULT;                // LRESULT = long long (8)
typedef unsigned int COLORREF;            // COLORREF = unsigned int (4)
typedef wchar_t WCHAR;                    // WCHAR = wchar_t (2)
typedef void *HANDLE;                     // 句柄族一律 void* (8)
typedef void *HWND;
typedef void *HDC;
typedef void *HINSTANCE;
typedef void *HMENU;
typedef void *HICON;
typedef void *HCURSOR;
typedef void *HBRUSH;
typedef void *HRGN;
typedef void *LPVOID;
typedef void *WPARAM;                     // 本文件既有映射：WPARAM 作 void*（SDK 为 UINT_PTR）
typedef char *LPSTR;
typedef const char *LPCSTR;
typedef wchar_t *LPWSTR;
typedef const wchar_t *LPCWSTR;
typedef unsigned char *LPBYTE;
typedef long long (*WNDPROC)(HWND, UINT, WPARAM, LPARAM);   // 即 LRESULT (CALLBACK*)(HWND,UINT,WPARAM,LPARAM)

// —— Win32 结构布局（public · x64/LLP64 自然对齐；此处只留跨段共用或无函数原型引用的通用结构，按依赖序 POINT→RECT→LARGE_INTEGER→MINMAXINFO→FILE_NOTIFY_INFORMATION→TOOLINFOW→GUID→LUID→NMHDR→NMCUSTOMDRAW→CREATESTRUCTW→DRAWITEMSTRUCT→MEASUREITEMSTRUCT）——
//   单库专用结构（仅被同一个库的函数引用）不留在本段，就近定义在对应库段的「<lib> 专用结构」小节、紧邻其使用者；判据＝原型区里该 struct 只出现在一个库段。
// 字段拼写＝SDK 别名（见上方别名段），底层宽度不变：DWORD/ULONG/COLORREF/UINT=unsigned int(4)·LONG/INT/BOOL=int(4)·WORD=unsigned short(2)·BYTE=unsigned char(1)·句柄/PTR/WPARAM=void*(8)·LPARAM/LRESULT/LONG_PTR=long long(8)·ULONGLONG/DWORDLONG/ULONG_PTR/UINT_PTR/DWORD_PTR=unsigned long long(8)；全文件不写 long/unsigned long（long 的定义将来会改，免连带漂移）。函数原型段仍按底层类型书写（本批只对齐结构体字段）；原型里句柄仍作 void*（不透明句柄、回调指针、多态输出缓冲、可选 SECURITY_ATTRIBUTES 按设计留 void*，非漏收紧）。已定义布局的 39 类型（38 struct + 1 union：LARGE_INTEGER；其中 13 个跨段共用或无原型引用者留在本段，26 个单库专用者下沉到各自库段——kernel32 9、user32 9、gdi32 2、comdlg32 2、shell32 2、comctl32 1、dwmapi 1）凡对应之新函数形参均用具体 struct*/union*（既有 RegCreateKeyExW 之可选 lpSecurityAttributes 依「不动既有原型」仍留 void*；注：MINMAXINFO 系 WM_GETMINMAXINFO 的 lParam 载荷、无函数原型引用）。仍留 void* 的结构类形参＝GetTextMetricsA/W 的 TEXTMETRIC*（字段多、手写布局易错且无运行期证伪、留待 win32metadata 自动生成）；其余尚无 public 布局的结构亦仍 void*。
public struct POINT
{
	LONG x;
	LONG y;
};
public struct RECT
{
	LONG left;
	LONG top;
	LONG right;
	LONG bottom;
};
public union LARGE_INTEGER
{
	struct { DWORD LowPart; LONG HighPart; };
	LONGLONG QuadPart;
};
// MINMAXINFO：WM_GETMINMAXINFO 的 lParam 指向本结构（5 个 POINT）；布局对照 SDK tagMINMAXINFO。
public struct MINMAXINFO
{
	struct POINT ptReserved;
	struct POINT ptMaxSize;
	struct POINT ptMaxPosition;
	struct POINT ptMinTrackSize;
	struct POINT ptMaxTrackSize;
};
// FILE_NOTIFY_INFORMATION：ReadDirectoryChangesW 输出条目（柔性 FileName、宽字符）。
public struct FILE_NOTIFY_INFORMATION
{
	DWORD NextEntryOffset;
	DWORD Action;
	DWORD FileNameLength;
	WCHAR FileName[1];
};
// TOOLINFOW：SendMessage(TTM_ADDTOOLW) 的 tooltip 项（内嵌 struct RECT）；对照 SDK tagTOOLINFOW。cbSize 填 sizeof、uId=UINT_PTR。
public struct TOOLINFOW
{
	UINT cbSize;
	UINT uFlags;
	HWND hwnd;
	UINT_PTR uId;
	struct RECT rect;
	HINSTANCE hinst;
	LPWSTR lpszText;
	LPARAM lParam;
	void *lpReserved;
};
// GUID：COM/注册表通用唯一标识；对照 SDK guiddef.h（Data4 为 8 字节数组）。sysmon 早期以私有别名 GUIDX 兜底，现行改用真名 GUID。
public struct GUID
{
	DWORD Data1;
	WORD Data2;
	WORD Data3;
	BYTE Data4[8];
};
// LUID：本地唯一标识符（显卡适配器/访问令牌）；对照 SDK winnt.h。sysmon 早期以私有别名 LUIDX 兜底，现行改用真名 LUID。
public struct LUID
{
	DWORD LowPart;
	LONG HighPart;
};
// NMHDR：通用控件 WM_NOTIFY 通知头；对照 SDK commctrl.h。idFrom=UINT_PTR、hwndFrom=HWND。
public struct NMHDR
{
	HWND hwndFrom;
	UINT_PTR idFrom;
	UINT code;
};
// NMCUSTOMDRAW：CDDS_* 自绘通知载荷（内嵌 struct NMHDR/RECT）；对照 SDK commctrl.h。dwItemSpec=DWORD_PTR、lItemlParam=LPARAM。
public struct NMCUSTOMDRAW
{
	struct NMHDR hdr;
	DWORD dwDrawStage;
	HDC hdc;
	struct RECT rc;
	DWORD_PTR dwItemSpec;
	UINT uItemState;
	LPARAM lItemlParam;
};
// CREATESTRUCTW：WM_CREATE 的 lParam 载荷；对照 SDK WinUser.h。句柄作 void*、lpszName/lpszClass 为 LPCWSTR。
public struct CREATESTRUCTW
{
	LPVOID lpCreateParams;
	HINSTANCE hInstance;
	HMENU hMenu;
	HWND hwndParent;
	int cy;
	int cx;
	int y;
	int x;
	LONG style;
	LPCWSTR lpszName;
	LPCWSTR lpszClass;
	DWORD dwExStyle;
};
// DRAWITEMSTRUCT：WM_DRAWITEM owner-draw 绘制参数（内嵌 struct RECT）；对照 SDK WinUser.h。CtlType/CtlID/itemID/itemAction/itemState 均 UINT、hwndItem=HWND、hDC=HDC、itemData=ULONG_PTR。
public struct DRAWITEMSTRUCT
{
	UINT CtlType;
	UINT CtlID;
	UINT itemID;
	UINT itemAction;
	UINT itemState;
	HWND hwndItem;
	HDC hDC;
	struct RECT rcItem;
	ULONG_PTR itemData;
};
// MEASUREITEMSTRUCT：WM_MEASUREITEM owner-draw 尺寸测量参数；对照 SDK WinUser.h。CtlType/CtlID/itemID/itemWidth/itemHeight 均 UINT、itemData=ULONG_PTR。
public struct MEASUREITEMSTRUCT
{
	UINT CtlType;
	UINT CtlID;
	UINT itemID;
	UINT itemWidth;
	UINT itemHeight;
	ULONG_PTR itemData;
};

// —— Win32 整型常量 · 跨库共用（P225/P226 起步；单库专用常量已下沉到各库段的「专用常量」小节）——
//   判据同结构体：常量只服务单一库（其取值只作为该库函数/结构的参数）→ 就近定义在该库段函数之前的「<lib> 专用常量」小节；被多个库共用的留本段。
//   机制：被 import 的 const int 全局可作运行期读取/数组维度/switch case 标签（P256：parser eval_const_int 穿透 const 全局/局部 VarRef；常量种子经 loader const_seeds 前置入主源解析期）。
//   非负哨兵（如 INVALID_FILE_ATTRIBUTES=0xFFFFFFFF）按 `const unsigned int` 声明与消费方同型，免符号位转换；const 限定当前不强制只读（本仓 sema 少诊断），按只读约定使用。
//   仅覆盖整型常量宏；MAKEINTRESOURCE/字符串/指针型宏仍需别的机制或维持硬编码（长期交 win32metadata 自动生成）。
//   来源与核对：P225/P226 起步子集 + 批次 VII–XII 扩展，取值逐个对照 Windows SDK〔10.0.26100.0〕winuser.h / wingdi.h / winbase.h / commctrl.h / commdlg.h / shlwapi.h / winnt.h / pdh.h / dwmapi.h。
public const int MAX_PATH = 260;

// —— kernel32 专用常量（仅本段函数使用；定义紧邻其使用者）——
// 基础码值（代码页标识 / 文件属性哨兵 / 成功码）
public const int CP_UTF8 = 65001;
public const unsigned int INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF;
public const int ERROR_SUCCESS = 0;
// 代码页 / 字符转换
public const unsigned int CP_ACP = 0;
public const unsigned int MB_ERR_INVALID_CHARS = 0x00000008;
// 进程创建 / 优先级 / 等待
public const unsigned int CREATE_NO_WINDOW = 0x08000000;
public const unsigned int STARTF_USESHOWWINDOW = 0x00000001;
public const unsigned int STARTF_USESTDHANDLES = 0x00000100;
public const unsigned int HANDLE_FLAG_INHERIT = 0x00000001;
public const unsigned int IDLE_PRIORITY_CLASS = 0x00000040;
public const int THREAD_PRIORITY_IDLE = -15;
public const unsigned int INFINITE = 0xFFFFFFFF;
// 目录 / 文件监视（CreateFileW / ReadDirectoryChangesW）
public const unsigned int FILE_LIST_DIRECTORY = 0x00000001;
public const unsigned int FILE_SHARE_READ = 0x00000001;
public const unsigned int FILE_SHARE_WRITE = 0x00000002;
public const unsigned int FILE_SHARE_DELETE = 0x00000004;
public const unsigned int OPEN_EXISTING = 3;
public const unsigned int FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
public const unsigned int FILE_FLAG_OVERLAPPED = 0x40000000;
public const unsigned int FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
public const unsigned int FILE_NOTIFY_CHANGE_FILE_NAME = 0x00000001;
public const unsigned int FILE_NOTIFY_CHANGE_DIR_NAME = 0x00000002;
public const unsigned int FILE_NOTIFY_CHANGE_LAST_WRITE = 0x00000008;
public const unsigned int FILE_ACTION_ADDED = 0x00000001;
public const unsigned int FILE_ACTION_REMOVED = 0x00000002;
public const unsigned int FILE_ACTION_MODIFIED = 0x00000003;
public const unsigned int FILE_ACTION_RENAMED_OLD_NAME = 0x00000004;
public const unsigned int FILE_ACTION_RENAMED_NEW_NAME = 0x00000005;
// 驱动器类型（GetDriveTypeW 返回值）
public const int DRIVE_FIXED = 3;

// —— kernel32 专用结构（仅本段函数使用；定义紧邻其使用者）——
public struct SYSTEMTIME
{
	WORD wYear;
	WORD wMonth;
	WORD wDayOfWeek;
	WORD wDay;
	WORD wHour;
	WORD wMinute;
	WORD wSecond;
	WORD wMilliseconds;
};
// FILETIME：100ns 计数时间（文件时间/FindData 载荷）；对照 SDK minwinbase.h。两 DWORD 组合为 64 位。
public struct FILETIME
{
	DWORD dwLowDateTime;
	DWORD dwHighDateTime;
};
// WIN32_FIND_DATAW：FindFirstFileW/FindNextFileW 的文件项；对照 SDK minwinbase.h。MAX_PATH=260、cAlternateFileName 为 8.3 名(14)。
public struct WIN32_FIND_DATAW
{
	DWORD dwFileAttributes;
	struct FILETIME ftCreationTime;
	struct FILETIME ftLastAccessTime;
	struct FILETIME ftLastWriteTime;
	DWORD nFileSizeHigh;
	DWORD nFileSizeLow;
	DWORD dwReserved0;
	DWORD dwReserved1;
	WCHAR cFileName[260];
	WCHAR cAlternateFileName[14];
};
// OVERLAPPED：异步 IO 状态块；SDK 的 union{Offset/OffsetHigh;Pointer} 摊成两 DWORD、x64 布局等价（32B）。
public struct OVERLAPPED
{
	ULONG_PTR Internal;
	ULONG_PTR InternalHigh;
	DWORD Offset;
	DWORD OffsetHigh;
	HANDLE hEvent;
};
// CRITICAL_SECTION：即 RTL_CRITICAL_SECTION（Initialize/Enter/Leave/DeleteCriticalSection 用）；对照 SDK x64。
public struct CRITICAL_SECTION
{
	ULONG_PTR DebugInfo;
	LONG LockCount;
	LONG RecursionCount;
	HANDLE OwningThread;
	HANDLE LockSemaphore;
	ULONG_PTR SpinCount;
};
// MEMORYSTATUSEX：GlobalMemoryStatusEx 的内存状态载荷；对照 SDK sysinfoapi.h。dwLength 填 sizeof。
public struct MEMORYSTATUSEX
{
	DWORD dwLength;
	DWORD dwMemoryLoad;
	DWORDLONG ullTotalPhys;
	DWORDLONG ullAvailPhys;
	DWORDLONG ullTotalPageFile;
	DWORDLONG ullAvailPageFile;
	DWORDLONG ullTotalVirtual;
	DWORDLONG ullAvailVirtual;
	DWORDLONG ullAvailExtendedVirtual;
};
// SECURITY_ATTRIBUTES：句柄继承/安全描述符（CreateProcessW/CreateFileW/CreatePipe 用）；对照 SDK。
public struct SECURITY_ATTRIBUTES
{
	DWORD nLength;
	LPVOID lpSecurityDescriptor;
	BOOL bInheritHandle;
};
// STARTUPINFOW：CreateProcessW 启动信息（进程/管道重定向用）；对照 SDK x64 tagSTARTUPINFOW。lpReserved/lpDesktop/lpTitle 实为 LPWSTR、此处按只读 const wchar_t* 声明不影响布局；cb 须由调用方填 sizeof。
public struct STARTUPINFOW
{
	DWORD cb;
	LPCWSTR lpReserved;
	LPCWSTR lpDesktop;
	LPCWSTR lpTitle;
	DWORD dwX;
	DWORD dwY;
	DWORD dwXSize;
	DWORD dwYSize;
	DWORD dwXCountChars;
	DWORD dwYCountChars;
	DWORD dwFillAttribute;
	DWORD dwFlags;
	WORD wShowWindow;
	WORD cbReserved2;
	LPBYTE lpReserved2;
	HANDLE hStdInput;
	HANDLE hStdOutput;
	HANDLE hStdError;
};
// PROCESS_INFORMATION：CreateProcessW 输出进程/线程句柄与 id；对照 SDK。
public struct PROCESS_INFORMATION
{
	HANDLE hProcess;
	HANDLE hThread;
	DWORD dwProcessId;
	DWORD dwThreadId;
};

// —— kernel32：CRT 默认拉入，无需 [[lib]]（段内按函数名字母序）——
public int CloseHandle(void *hObject);
public void ExitProcess(unsigned int uExitCode);
public unsigned int ExpandEnvironmentStringsW(const wchar_t *lpSrc, wchar_t *lpDst, unsigned int nSize);
public int FreeConsole(void);
public int FreeLibrary(void *hModule);
public char* GetCommandLineA(void);
public wchar_t* GetCommandLineW(void);
public int GetComputerNameA(char *lpBuffer, unsigned int *nSize);
public int GetComputerNameW(wchar_t *lpBuffer, unsigned int *nSize);
public void* GetConsoleWindow(void);
public unsigned int GetCurrentDirectoryA(unsigned int nBufferLength, char *lpBuffer);
public unsigned int GetCurrentDirectoryW(unsigned int nBufferLength, wchar_t *lpBuffer);
public void* GetCurrentProcess(void);
public unsigned int GetCurrentProcessId(void);
public unsigned int GetCurrentThreadId(void);
public unsigned int GetEnvironmentVariableA(const char *lpName, char *lpBuffer, unsigned int nSize);
