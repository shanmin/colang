public unsigned int GetTempPathA(unsigned int nBufferLength, char *lpBuffer);
public unsigned int GetTempPathW(unsigned int nBufferLength, wchar_t *lpBuffer);
public unsigned int GetTickCount(void);
public unsigned long long GetTickCount64(void);
public unsigned short GetUserDefaultLangID(void);
public unsigned int GetWindowsDirectoryA(char *lpBuffer, unsigned int uBufSize);
public unsigned int GetWindowsDirectoryW(wchar_t *lpBuffer, unsigned int uBufSize);
