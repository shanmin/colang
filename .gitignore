# ---------------------------------------------------------------------------
# colang — Git 忽略规则
# ---------------------------------------------------------------------------

# 构建输出目录（build.bat 产物落在 /build；CMake presets 产物落在 /out）
/build/
/out/
/.vs/
CMakeCache.txt
CMakeFiles/

# 编译 / 链接中间产物
*.obj
*.exe
*.dll
*.lib
*.bc
*.ll
*.pdb
*.ilk

# 本地调试 / 临时产物
/_tmp/
/_regress_tmp/

# 大型外部测试数据（仅内部回归使用，不纳入公开仓库）
/test/c-testsuite-master/
/test/compiler-test-suite-2026-06/
/test/p8_project/
/test/sema_negative/

# 发布包（dist）：随仓库分发的编译器主程序豁免于 *.exe 忽略
!dist/colang.exe

# 编辑器 / 操作系统杂项
*.user
Thumbs.db
.DS_Store
